raw `
Meta_SubductionZone_MapScripts::
	puzzle_info Puzzle_MetaPuzzle_Name, CommonAuthor_Tustin2121
	map_script MAP_SCRIPT_ON_TRANSITION, Meta_SubductionZone_OnTransition
	map_script MAP_SCRIPT_ON_LOAD, Meta_SubductionZone_OnLoad
	.byte 0
`

script(local) Meta_SubductionZone_OnTransition {
	// set_meta_visited_flag(MAP_META_SUBDUCTION_ZONE)
}
script(local) Meta_SubductionZone_OnLoad {
	check_meta_visited_flag(MAP_META_SUBDUCTION_ZONE)
	goto_if(FALSE, Common_EventScript_NopReturn)
	call(Meta_SubductionZone_BreakOpenShortcut)
	turnobject(5, DIR_NORTH)
	turnobject(6, DIR_NORTH)
	setvar(VAR_TEMP_0, 1)
	return
}

script(local) Meta_SubductionZone_BreakOpenShortcut {
	setmetatile(19, 18, 0x170, FALSE)
	setmetatile(20, 18, 0x170, FALSE)
	setmetatile(19, 19, 0x170, FALSE)
	setmetatile(20, 19, 0x170, FALSE)
	setmetatile(19, 20, 0x170, FALSE)
	setmetatile(20, 20, 0x170, FALSE)
	setmetatile(19, 21, 0x170, FALSE)
	setmetatile(20, 21, 0x170, FALSE)
	setmetatile(18, 20, 0x170, FALSE)
	setmetatile(21, 19, 0x170, FALSE)
	return
}

//-----------------------------------------------------

script Meta_SubductionZone_TriggerScript_CompletePuzzle {
	lock
	turnobject(5, DIR_NORTH)
	turnobject(6, DIR_NORTH)
	set_meta_visited_flag(MAP_META_SUBDUCTION_ZONE)
	playse (SE_PIN)
	delay(40)
	
	call (Meta_SubductionZone_BreakOpenShortcut)
	special(DrawWholeMapView)
	playse (SE_M_STRENGTH)
	setvar (VAR_0x8004, 2)  #amplitude y
	setvar (VAR_0x8005, 0)  #amplitude x
	setvar (VAR_0x8006, 2)  #duration (num shakes)
	setvar (VAR_0x8007, 5)  #frequency
	special (ShakeCamera)
	waitstate
	setvar(VAR_TEMP_0, 1)
	release
}
