script TestMapHallway_GiveTestBears {
	finditem_std(ITEM_TABLE_CANDY_ABUNDANT, 1)
}

script TestMapHallway_GiveTestItems3 {
	finditem_std(ITEM_LEFTOVERS, 1)
}

