script MetaPuzzle_ResetLayoutAsk {
	lockall
	faceplayer
	speakername_common(TRICK_MASTER)
	if (!flag(FLAG_MET_TRICK_MASTER)) {
		message("Ah ha! Hello there! I presume it is you\n"
				"who are helping my step-sister then?\p"
				"It is certainly an impressive puzzle!\n"
				"Though maybe a bit rough!\p"
				"I see you here! And not IN the\n"
				"puzzle, by the way!\p"
				"I take it you needed to escape?\n"
				"Perhaps you need back in?\p"
				"I can reset the room layout for you\n"
				"if you cannot find your way back in!\p$")
		waitmessage
		setflag(FLAG_MET_TRICK_MASTER)
	}
	msgbox(	"Do you need me to reset\n"
			"the room layout?", MSGBOX_YESNO)
	if (var(VAR_RESULT) == YES) {
		msgbox ("It shall be done then!\n"
				"Hold on to your hat!$")
		closemessage
		callnative(MetaPuzzle_RestorePuzzleLayout) // will re-init the map
		applymovement(THIS_EVENT, MetaPuzzle_ChangeRoomLayout_TrickMasterReact)
		waitmovement(THIS_EVENT)
		call(MetaPuzzle_ChangeRoomLayout_ShakeScript)
		switch (var(VAR_FACING)) {
			case DIR_NORTH:
				applymovement(LID_PLAYER, Common_Movement_WalkInPlaceUp)
				applymovement(THIS_EVENT, Common_Movement_WalkInPlaceDown)
			case DIR_SOUTH:
				applymovement(LID_PLAYER, Common_Movement_WalkInPlaceDown)
				applymovement(THIS_EVENT, Common_Movement_WalkInPlaceUp)
			case DIR_WEST:
				applymovement(LID_PLAYER, Common_Movement_WalkInPlaceLeft)
				applymovement(THIS_EVENT, Common_Movement_WalkInPlaceRight)
			case DIR_EAST:
				applymovement(LID_PLAYER, Common_Movement_WalkInPlaceRight)
				applymovement(THIS_EVENT, Common_Movement_WalkInPlaceLeft)
		}
		waitmovement(LID_PLAYER)
		// faceplayer
		msgbox ("There you go! Everything should be back\n"
				"to the way it was at the start!\p"
				"Good luck on the puzzle!$")
	} else {
		msgbox ("Very well!\n"
				"Good luck on the puzzle!$")
	}
	releaseall
}
script MetaPuzzle_UsePedestal {
	lockall
	
	callnative(MetaPuzzle_OpenSlidingPuzzle) // will re-init the map
	waitstate
	
	if (var(VAR_RESULT) == TRUE) {
		addvar(VAR_TIMES_SHIFTED, 1)
		call(MetaPuzzle_ChangeRoomLayout_ShakeScript)
	}
	releaseall
}

script(local) MetaPuzzle_ChangeRoomLayout_ShakeScript {
	# Start shaking
	playse (SE_M_EARTHQUAKE)
	playse (SE_M_STRENGTH)
	setvar (VAR_0x8004, 5)  #amplitude y
	setvar (VAR_0x8005, 0)  #amplitude x
	setvar (VAR_0x8006, 15)  #duration (num shakes)
	setvar (VAR_0x8007, 5)  #frequency
	special (ShakeCamera)
	applymovement(LID_PLAYER, MetaPuzzle_ChangeRoomLayout_PlayerReact)
	// delay (81)
	waitstate
	# continue shaking
	setvar (VAR_0x8004, 2)  #amplitude y
	setvar (VAR_0x8005, 0)  #amplitude x
	setvar (VAR_0x8006, 11)  #duration (num shakes)
	setvar (VAR_0x8007, 5)  #frequency
	special (ShakeCamera)
	// delay (61)
	waitstate
	waitmovement(LID_PLAYER)
	# final shaking
	setvar (VAR_0x8004, 1)  #amplitude y
	setvar (VAR_0x8005, 0)  #amplitude x
	setvar (VAR_0x8006, 11)  #duration (num shakes)
	setvar (VAR_0x8007, 5)  #frequency
	special (ShakeCamera)
	waitstate
	// delay (40)
	return
}
movement MetaPuzzle_ChangeRoomLayout_TrickMasterReact {
	face_up       delay_4
	face_left     delay_4
	face_down     delay_4
	face_right    delay_4
	face_up       delay_4
	face_left     delay_4
	face_right    delay_4
	face_up       delay_4
}
movement MetaPuzzle_ChangeRoomLayout_PlayerReact {
	delay_16
	emote_exclamation_mark
	walk_in_place_fast_up
	delay_2
	walk_in_place_fast_right
	delay_2
	walk_in_place_fast_left
	delay_2
	delay_1
	walk_in_place_fast_down
}

