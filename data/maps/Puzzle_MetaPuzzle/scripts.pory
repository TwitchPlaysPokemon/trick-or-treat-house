script(local) Puzzle_MetaPuzzle_RedirectWarp {
	if (var(VAR_GRID_SIZE) != 0) {
		setwarp(WARPTYPE_STANDARD, MAP_META_ENTRANCE, 0)
	}
}

script(local) Puzzle_MetaPuzzle_PuzzleSetup {
	setberrytree(BERRY_TREE_META_ROOM_04, ITEM_TO_BERRY(ITEM_SITRUS_BERRY), BERRY_STAGE_BERRIES)
	setberrytree(BERRY_TREE_META_ROOM_05, ITEM_TO_BERRY(ITEM_ORAN_BERRY), BERRY_STAGE_BERRIES)
	setberrytree(BERRY_TREE_META_ROOM_06, ITEM_TO_BERRY(ITEM_CHERI_BERRY), BERRY_STAGE_BERRIES)
	setberrytree(BERRY_TREE_META_ROOM_07, ITEM_TO_BERRY(ITEM_PECHA_BERRY), BERRY_STAGE_BERRIES)
	setberrytree(BERRY_TREE_META_ROOM_08, ITEM_TO_BERRY(ITEM_RAZZ_BERRY), BERRY_STAGE_BERRIES)
	setberrytree(BERRY_TREE_META_ROOM_09, ITEM_TO_BERRY(ITEM_ASPEAR_BERRY), BERRY_STAGE_BERRIES)
	setberrytree(BERRY_TREE_META_ROOM_10, ITEM_TO_BERRY(ITEM_LANSAT_BERRY), BERRY_STAGE_BERRIES)
