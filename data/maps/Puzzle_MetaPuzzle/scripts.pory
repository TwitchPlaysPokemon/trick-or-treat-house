// Intro Script

script Puzzle_MetaPuzzle_IntroScript {
	speakername_common(TRICK_MISTRESS)
	message("Hello again. This is it.\n"
			"This is my big chance.\p"
			"Well, what puzzle essences have you\n"
			"managed to find tonight? Let's see…\p$")
	waitmessage
	message("…{PAUSE 30} …{PAUSE 30} …{PAUSE 30} …{PAUSE 30}\p$")
	applymovement(LID_MASTER, Common_Movement_WalkInPlaceRight)
	delay(30)
	applymovement(LID_PLAYER, Common_Movement_WalkInPlaceUp)
	callnative(MetaPuzzle_DeterminePuzzleSetup)
	waitmessage
	applymovement(LID_PLAYER, Common_Movement_WalkInPlaceRight)
	waitmovement(LID_PLAYER)
	switch(var(VAR_RESULT)) {
		case 0: // ERROR!
			message("Oh god! My nose! I'm bleeding!\n"
					"Uh, uh, uh, uh…!\p"
					"It must be the nerves! I have to go!\n"
					"Where's the bathroom?!$")
			applymovement(LID_PLAYER, Common_Movement_QuestionMark)
			waitmessage
			waitbuttonpress
			closemessage
			applymovement(LID_MASTER, Puzzle_MetaPuzzle_IntroMovement_Flannery_Error)
			applymovement(LID_PLAYER, Puzzle_MetaPuzzle_IntroMovement_Player_Error)
			playse(SE_PIN)
			waitmovement(LID_MASTER)
			removeobject(LID_MASTER)
			// Player approaches door
			applymovement(LID_PLAYER, Common_Movement_WalkUp1)
			waitmovement(LID_PLAYER)
			// Open the door to the puzzle
			opendoor(22, 2)
			waitdooranim
			// Clean up
			setvar(VAR_PUZZLE_STATE, 1)
			setescapewarp(MAP_TRICK_HOUSE_CORRIDOR, -1, 22, 3)
			call (TrickHouseCorridor_OpenPuzzleDoor)
			releaseall
			end
		case 1: // Pathetic layout
			message("Wait… How--? How did you LOSE the\n"
					"pieces I gave you?!\p")
			waitmessage
			message("I'm… I can't…$")
			applymovement(LID_MASTER, Common_Movement_WalkInPlaceLeft)
			waitmovement(LID_MASTER)
			waitmessage
			waitbuttonpress
			closemessage
			goto(Puzzle_MetaPuzzle_IntroScript_BadPuzzleWalkout)
		case 2: // Bad layout
			message("Uh… Th-There's not much here…\n"
					"There's not enough…\p$")
			waitmessage
			message("I, uh…{PAUSE 30} I can't do anything with this…!\n"
					"… … … …{PAUSE 30}\p"
					"I…{PAUSE 30} I'm just gonna… … … …$")
			applymovement(LID_MASTER, Common_Movement_WalkInPlaceLeft)
			waitmovement(LID_MASTER)
			waitmessage
			waitbuttonpress
			closemessage
			goto(Puzzle_MetaPuzzle_IntroScript_BadPuzzleWalkout)
		case 3: // Good layout
			message("Okay! This works…! It's not ideal\n"
					"but I can work with it!\p$")
			waitmessage
			message("I can make a puzzle with this!\n"
					"It's not as big as I want…\l"
					"but it's good! This is good!\p"
					"I think this can actually show up my\n"
					"brother! Thank you!\p"
					"Let's head inside!$")
			applymovement(LID_MASTER, Common_Movement_WalkInPlaceLeft)
			waitmovement(LID_MASTER)
			waitmessage
			waitbuttonpress
			closemessage
			goto(Puzzle_MetaPuzzle_IntroScript_GoodPuzzleWalkout)
		case 4: // Best layout
			message("Oh my goodness! You DID it!!\p$")
			waitmessage
			message("You've got enough pieces here to build\n"
					"the puzzle of my dreams! Yes!\p"
					"Excellent! I can truly show up my brother\n"
					"now! Who's the REAL Trick Master now?!\p"
					"Come on! Let's check it out!$")
			applymovement(LID_MASTER, Common_Movement_WalkInPlaceLeft)
			applymovement(LID_PLAYER, Common_Movement_ExclamationMark)
			playse(SE_PIN)
			waitmovement(LID_MASTER)
			waitmessage
			waitbuttonpress
			closemessage
			goto(Puzzle_MetaPuzzle_IntroScript_GoodPuzzleWalkout)
	}
}

script Puzzle_MetaPuzzle_IntroScript_BadPuzzleWalkout {
	applymovement(LID_MASTER, Puzzle_MetaPuzzle_IntroMovement_Flannery_Bad)
	applymovement(LID_PLAYER, Puzzle_MetaPuzzle_IntroMovement_Player_Bad)
	waitmovement(LID_MASTER)
	removeobject(LID_MASTER)
	// Player approaches door
	applymovement(LID_PLAYER, Common_Movement_WalkUp2)
	waitmovement(0)
	// Open the door to the puzzle
	opendoor(22, 2)
	waitdooranim
	// Clean up
	setvar(VAR_PUZZLE_STATE, 1)
	setescapewarp(MAP_TRICK_HOUSE_CORRIDOR, -1, 22, 3)
	call (TrickHouseCorridor_OpenPuzzleDoor)
	releaseall
	end
}
script Puzzle_MetaPuzzle_IntroScript_GoodPuzzleWalkout {
	// Player approaches door
	applymovement(LID_PLAYER, Common_Movement_WalkUp2)
	applymovement(LID_MASTER, Common_Movement_WalkUp2)
	waitmovement(0)
	// Open the door to the puzzle
	opendoor(22, 2)
	waitdooranim
	// intro character walks through
	applymovement(LID_MASTER, Puzzle_MetaPuzzle_IntroMovement_Flannery_Good1)
	waitmovement(LID_MASTER)
	applymovement(LID_MASTER, Puzzle_MetaPuzzle_IntroMovement_Flannery_Good2)
	playse(SE_LEDGE)
	waitmovement(LID_MASTER)
	removeobject(LID_MASTER)
	playse(SE_EXIT)
	// Clean up
	setvar(VAR_PUZZLE_STATE, 1)
	setescapewarp(MAP_TRICK_HOUSE_CORRIDOR, -1, 22, 3)
	call (TrickHouseCorridor_OpenPuzzleDoor)
	releaseall
	end
}

movement Puzzle_MetaPuzzle_IntroMovement_Flannery_Error {
	walk_fast_down
	walk_fast_left * 9
}
movement Puzzle_MetaPuzzle_IntroMovement_Player_Error {
	emote_exclamation_mark
	delay_16
	face_down
	delay_16 * 2
	face_left
}
movement Puzzle_MetaPuzzle_IntroMovement_Flannery_Bad {
	walk_slow_down
	walk_slow_left * 3
	walk_left * 6
}
movement Puzzle_MetaPuzzle_IntroMovement_Player_Bad {
	delay_16
	face_down
	delay_16 * 5
	face_left
}
movement Puzzle_MetaPuzzle_IntroMovement_Flannery_Good1 {
	walk_up
	walk_left
	walk_up
	delay_16
	face_down
}
movement Puzzle_MetaPuzzle_IntroMovement_Flannery_Good2 {
	jump_in_place_down
	walk_fast_up
	set_invisible
}


