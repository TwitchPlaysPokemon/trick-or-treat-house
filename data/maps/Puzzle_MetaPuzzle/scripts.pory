script MetaPuzzle_PickupEvent_InflatableRock {  // placed
	msgbox ("This rock appears to be… inflatable…?$")
	finditem_std(ITEM_META_ITEM_FINAL_BLUFF, 1)
	setvar(VAR_TRICK_MASTER_INTRO, 3)
}
script MetaPuzzle_PickupEvent_ZigzagCushion {   // placed
	msgbox ("This soft fluffy cushion is covered in\n"
			"ZIGZAGOON sheddings, like they've been\l"
			"laying on it a lot.$")
	finditem_std(ITEM_META_ITEM_ZIGGY, 1)
}
script MetaPuzzle_PickupEvent_LotadDoll {  // placed
	msgbox ("There's a waterlogged LOTAD doll,\n"
			"lost and washed away, floating here.$")
	finditem_std(ITEM_META_ITEM_LOG_FLOAT, 1)
}
script MetaPuzzle_PickupEvent_GrassCushion {  // placed
	msgbox ("Weird, there's a pillow just lying\n"
			"here on the forest floor.$")
