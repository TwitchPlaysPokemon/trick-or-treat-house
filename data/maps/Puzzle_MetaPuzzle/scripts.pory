script Puzzle_MetaPuzzle_IntroScript_NoPuzzleWalkout {
	applymovement(2, Puzzle_MetaPuzzle_IntroScript_NoPuzzleWalkout_Move1)
	applymovement(LID_PLAYER, Puzzle_MetaPuzzle_IntroScript_NoPuzzleWalkout_Move2)
	waitmovement(2)
	// Player approaches door
	applymovement(LID_PLAYER, Common_Movement_WalkUp2)
	waitmovement(0)
	// Open the door to the puzzle
	opendoor(22, 2)
	waitdooranim
	// Clean up
	setvar(VAR_PUZZLE_STATE, 1)
	setescapewarp(MAP_TRICK_HOUSE_CORRIDOR, -1, 22, 3)
	call (TrickHouseCorridor_OpenPuzzleDoor)
	releaseall
}

movement Puzzle_MetaPuzzle_IntroScript_NoPuzzleWalkout_Move1 {
	walk_slow_down
	walk_slow_left * 2
	walk_left * 3
	walk_fast_left * 3
}
movement Puzzle_MetaPuzzle_IntroScript_NoPuzzleWalkout_Move2 {
	delay_16
	face_down
	delay_16 * 5
	face_left
}

