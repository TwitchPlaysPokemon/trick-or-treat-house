raw `
#define VAR_GRID_SIZE         VAR_PUZZLE_00
#define VAR_ROOM_ID_0_0       VAR_PUZZLE_01
#define VAR_ROOM_RESERVE_END  VAR_PUZZLE_10

// FLAG_PUZZLE_20 (+25) = Visited/Finished room flags
// ...FLAG_PUZZLE_39
// FLAG_PUZZLE_ITEM_0 = watering can in Ziggy room

#define VAR_LOC_SCROLL     VAR_PUZZLE_11
#define VAR_LOC_CUT        VAR_PUZZLE_12
#define VAR_LOC_ROCK_SMASH VAR_PUZZLE_13
#define VAR_LOC_STRENGTH   VAR_PUZZLE_14
#define VAR_LOC_DIVE       VAR_PUZZLE_15
#define VAR_LOC_WATERFALL  VAR_PUZZLE_16
// First pedestal is always in Lavaridge
#define VAR_LOC_PEDESTAL2  VAR_PUZZLE_17
#define VAR_LOC_PEDESTAL3  VAR_PUZZLE_18
#define VAR_LOC_PEDESTAL4  VAR_PUZZLE_19

Puzzle_MetaPuzzle_MapScripts::
	puzzle_info Puzzle_MetaPuzzle_Name, CommonAuthor_Tustin2121
	puzzle_quip Puzzle_MetaPuzzle_Quip
	puzzle_metavars Puzzle_MetaPuzzle_Variables
	puzzle_candylist Puzzle_MetaPuzzle_CandyList
	map_script MAP_SCRIPT_ON_LOAD, Puzzle_MetaPuzzle_OnLoad
	map_script MAP_SCRIPT_ON_PUZZLE_CUSTOM_INTRO, Puzzle_MetaPuzzle_IntroScript
	.byte 0

Puzzle_MetaPuzzle_Name:
	.string "Secret Caverns$"
Puzzle_MetaPuzzle_Quip:
	@ TODO: When this puzzle is not a stub, this will be a script instead
	.string "Clearly, no one can do a better job\n"
	.string "than the TRICK MASTER himself!$"
.align 2
Puzzle_MetaPuzzle_Variables:
	.2byte VAR_INTRO_PERSON, OBJ_EVENT_GFX_FLANNERY
	.2byte VAR_QUIP_PERSON,  OBJ_EVENT_GFX_TRICK_MASTER
	.2byte 0
Puzzle_MetaPuzzle_CandyList:
	@ TODO: When this puzzle is not a stub, these will mean something
	@ Dive Maze
	.2byte FLAG_CANDY_ABUNDANT_01
	.2byte FLAG_CANDY_ABUNDANT_02
	.2byte FLAG_CANDY_ABUNDANT_03
	.2byte FLAG_CANDY_ABUNDANT_04
	.2byte FLAG_CANDY_ABUNDANT_05
	.2byte FLAG_CANDY_ABUNDANT_06
	.2byte FLAG_CANDY_COMMON_01
	.2byte FLAG_CANDY_COMMON_02
	.2byte FLAG_CANDY_UNCOMMON_01
	.2byte FLAG_CANDY_RARE_01
	.2byte FLAG_CANDY_RARE_02
	.2byte FLAG_CANDY_HEALTHY_01
	@ 
	.2byte FLAG_PUZZLE_20
	.2byte FLAG_PUZZLE_20
	.2byte FLAG_PUZZLE_20
	.2byte FLAG_PUZZLE_20
	.2byte FLAG_PUZZLE_20
	.2byte FLAG_PUZZLE_20
	.2byte FLAG_PUZZLE_20
	.2byte FLAG_PUZZLE_20
	.2byte FLAG_PUZZLE_20
	.2byte FLAG_PUZZLE_20
	.2byte FLAG_PUZZLE_20
	.2byte FLAG_PUZZLE_20
	.2byte FLAG_PUZZLE_20
	.2byte FLAG_PUZZLE_20
	.2byte FLAG_PUZZLE_20
	.2byte FLAG_PUZZLE_20
	.2byte FLAG_PUZZLE_20
	.2byte FLAG_PUZZLE_20
	.2byte FLAG_PUZZLE_20
	.2byte 0
`
