// Test scripts:

script MetaPuzzle_TestSetup4x4 {
	lockall
	setvar(VAR_GRID_SIZE, (4 << 8) | (4))
	setvar(VAR_ROOM_ID_0_0 + 0, MAP_META_BERRY_ROOM)
	setvar(VAR_ROOM_ID_0_0 + 1, MAP_META_LOG_FLOTILLA)
	setvar(VAR_ROOM_ID_0_0 + 2, MAP_META_FINAL_BLUFF)
	setvar(VAR_ROOM_ID_0_0 + 3, MAP_META_POKE_STAGE)
	
	setvar(VAR_ROOM_ID_0_0 + 4, MAP_META_ZIGGY_ROOM)
	setvar(VAR_ROOM_ID_0_0 + 5, MAP_META_ICE_CORNER)
	setvar(VAR_ROOM_ID_0_0 + 6, MAP_META_EMPTY_NW)
	setvar(VAR_ROOM_ID_0_0 + 7, MAP_META_SUBDUCTION_ZONE)
	
	setvar(VAR_ROOM_ID_0_0 + 8, MAP_META_DIVE_MAZE)
	setvar(VAR_ROOM_ID_0_0 + 9, MAP_META_BIKE_PATH)
	setvar(VAR_ROOM_ID_0_0 + 10, MAP_META_FOREST_CLEARING)
	setvar(VAR_ROOM_ID_0_0 + 11, MAP_META_KOGA_ELBOW)
	
	setvar(VAR_ROOM_ID_0_0 + 12, MAP_META_LEDGE_ROOM)
	setvar(VAR_ROOM_ID_0_0 + 13, MAP_META_ZIP_SLIDE)
	setvar(VAR_ROOM_ID_0_0 + 14, MAP_META_LAVARIDGE_SPRINGS)
	setvar(VAR_ROOM_ID_0_0 + 15, MAP_META_NULL_ROOM)
	
	message("Setup 4x4$")
	waitmessage
	waitbuttonpress
	
	getplayerxy(VAR_INTERACT_X, VAR_INTERACT_Y)
	setwarp(WARPTYPE_STANDARD, MAP_META_LAVARIDGE_SPRINGS, VAR_INTERACT_X, VAR_INTERACT_Y)
	dowarp(WARPTYPE_STANDARD, DOWARP_SILENT)
	releaseall
}

