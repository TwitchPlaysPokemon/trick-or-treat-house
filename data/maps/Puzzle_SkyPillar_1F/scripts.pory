raw `
Puzzle_SkyPillar_1F_MapScripts::
	puzzle_info Puzzle_SkyPillar_1F_Name, Puzzle_SkyPillar_1F_Author, PUZZLE_FLAG_GAME_FREAK
	puzzle_adjective Puzzle_SkyPillar_1F_Adjective
	puzzle_quip Puzzle_SkyPillar_1F_Quip
	//puzzle_setup_script Puzzle_SkyPillar_1F_SetupScript
	puzzle_item_prereqs Puzzle_SkyPillar_1F_Items
	puzzle_metavars Puzzle_SkyPillar_1F_Variables
	puzzle_candylist Puzzle_SkyPillar_1F_CandyList
	//map_script MAP_SCRIPT_ON_RESUME, Puzzle_SkyPillar_1F_OnResume
	//map_script MAP_SCRIPT_ON_FRAME_TABLE, Puzzle_SkyPillar_1F_FrameTable
	//map_script MAP_SCRIPT_ON_LOAD, Puzzle_SkyPillar_1F_OnLoad
	.byte 0

Puzzle_SkyPillar_1F_Name:
	.string "Celestial Ascension$"
Puzzle_SkyPillar_1F_Author:
	.string "YugnatZero$"
Puzzle_SkyPillar_1F_Adjective:
	.string "crackling$"
Puzzle_SkyPillar_1F_Quip:
	.string "I've heard that there's an item hidden\n"
	.string "somewhere in that tower that could \l"
	.string "boost the power of my Marowak.\p"
	.string "…If that turns out to be a dud, I'm\n"
	.string "gonna have a bone to pick with whoever\l"
	.string "started that rumor.$"
.align 2
Puzzle_SkyPillar_1F_Items:
	.2byte ITEM_MACH_BIKE
	.2byte 0
Puzzle_SkyPillar_1F_Variables:
	.2byte VAR_QUIP_PERSON,  OBJ_EVENT_GFX_LASS
	.2byte 0
Puzzle_SkyPillar_1F_CandyList:
	.2byte FLAG_CANDY_COMMON_01
	.2byte 0

`
