raw `
Meta_KogaElbow_MapScripts::
	puzzle_info Puzzle_MetaPuzzle_Name, CommonAuthor_Tustin2121
	map_script MAP_SCRIPT_ROOM_NAME, Meta_KogaElbow_RoomName
	map_script MAP_SCRIPT_ON_TRANSITION, Meta_KogaElbow_OnTransition
	map_script MAP_SCRIPT_ON_RESUME, Meta_KogaElbow_OnResume
	map_script MAP_SCRIPT_ON_LOAD, Meta_KogaElbow_OnLoad
	map_script MAP_SCRIPT_ON_UNLOAD, Meta_KogaElbow_OnUnload
	.byte 0
Meta_KogaElbow_RoomName:
	.string "Koga's Elbow$"
`
script(local) Meta_KogaElbow_OnLoad {
	if (var(VAR_LOC_CUT)         == MAP_META_KOGA_ELBOW) { setobjectxyperm(16, 19, 19) } else { setobjectxyperm(16, 100, 100) }
	if (var(VAR_LOC_ROCK_SMASH)  == MAP_META_KOGA_ELBOW) { setobjectxyperm(17, 19, 19) } else { setobjectxyperm(17, 100, 100) }
	if (var(VAR_LOC_STRENGTH)    == MAP_META_KOGA_ELBOW) { setobjectxyperm(18, 19, 19) } else { setobjectxyperm(18, 100, 100) }
	if (var(VAR_LOC_DIVE)        == MAP_META_KOGA_ELBOW) { setobjectxyperm(19, 19, 19) } else { setobjectxyperm(19, 100, 100) }
	if (var(VAR_LOC_WATERFALL)   == MAP_META_KOGA_ELBOW) { setobjectxyperm(20, 19, 19) } else { setobjectxyperm(20, 100, 100) }
	if (var(VAR_LOC_SURF)        == MAP_META_KOGA_ELBOW) { setobjectxyperm(15, 19, 19) } else { setobjectxyperm(15, 100, 100) }
	
	if (var(VAR_LOC_PEDESTAL2) != MAP_META_KOGA_ELBOW 
	 && var(VAR_LOC_PEDESTAL3) != MAP_META_KOGA_ELBOW 
	 && var(VAR_LOC_PEDESTAL4) != MAP_META_KOGA_ELBOW)
	     { setobjectxyperm(5, 100, 100) }
	else { setobjectxyperm(5, 20, 20) }
	
	check_meta_visited_flag(MAP_META_KOGA_ELBOW)
	goto_if(FALSE, Common_EventScript_NopReturn)
	call(Meta_KogaElbow_PlaceTopShortcut)
	call(Meta_KogaElbow_PlaceSideShortcut)
	setmetatile(21, 21, METATILE_TrickHousePuzzle_Button_Pressed, FALSE)
	setvar(VAR_TEMP_0, 1)
	return
}

script(local) Meta_KogaElbow_OnTransition {
	// set_meta_visited_flag(MAP_META_KOGA_ELBOW)
}

script(local) Meta_KogaElbow_OnResume {
	setstepcallback(STEP_CB_HIDDEN_WALLS)
}
script(local) Meta_KogaElbow_OnUnload {
	setstepcallback(STEP_CB_DUMMY)
}

//-----------------------------------------------------

script(local) Meta_KogaElbow_PlaceTopShortcut {
	setmetatile(19, 11, METATILE_MetaTileset_Planks_VertTop, FALSE)
	setmetatile(20, 11, METATILE_MetaTileset_Planks_VertTop, FALSE)
	setmetatile(19, 12, METATILE_MetaTileset_Planks_VertMid, FALSE)
	setmetatile(20, 12, METATILE_MetaTileset_Planks_VertMid, FALSE)
	setmetatile(19, 13, METATILE_MetaTileset_Planks_VertMid, FALSE)
	setmetatile(20, 13, METATILE_MetaTileset_Planks_VertMid, FALSE)
	setmetatile(19, 14, METATILE_MetaTileset_Planks_VertMid, FALSE)
	setmetatile(20, 14, METATILE_MetaTileset_Planks_VertMid, FALSE)
	setmetatile(19, 15, METATILE_MetaTileset_Planks_VertMid, FALSE)
	setmetatile(20, 15, METATILE_MetaTileset_Planks_VertMid, FALSE)
	setmetatile(19, 16, METATILE_MetaTileset_Planks_VertMid, FALSE)
	setmetatile(20, 16, METATILE_MetaTileset_Planks_VertMid, FALSE)
	setmetatile(19, 17, METATILE_MetaTileset_Planks_VertMid, FALSE)
	setmetatile(20, 17, METATILE_MetaTileset_Planks_VertMid, FALSE)
	setmetatile(19, 18, METATILE_MetaTileset_Planks_VertBot, FALSE)
	setmetatile(20, 18, METATILE_MetaTileset_Planks_VertBot, FALSE)
	return
}
script(local) Meta_KogaElbow_PlaceSideShortcut {
	setmetatile(12, 19, METATILE_MetaTileset_Planks_HorzLeft, FALSE)
	setmetatile(12, 20, METATILE_MetaTileset_Planks_HorzLeft, FALSE)
	setmetatile(13, 19, METATILE_MetaTileset_Planks_HorzMid, FALSE)
	setmetatile(13, 20, METATILE_MetaTileset_Planks_HorzMid, FALSE)
	setmetatile(14, 19, METATILE_MetaTileset_Planks_HorzMid, FALSE)
	setmetatile(14, 20, METATILE_MetaTileset_Planks_HorzMid, FALSE)
	setmetatile(15, 19, METATILE_MetaTileset_Planks_HorzMid, FALSE)
	setmetatile(15, 20, METATILE_MetaTileset_Planks_HorzMid, FALSE)
	setmetatile(16, 19, METATILE_MetaTileset_Planks_HorzMid, FALSE)
	setmetatile(16, 20, METATILE_MetaTileset_Planks_HorzMid, FALSE)
	setmetatile(17, 19, METATILE_MetaTileset_Planks_HorzMid, FALSE)
	setmetatile(17, 20, METATILE_MetaTileset_Planks_HorzMid, FALSE)
	setmetatile(18, 19, METATILE_MetaTileset_Planks_HorzRight, FALSE)
	setmetatile(18, 20, METATILE_MetaTileset_Planks_HorzRight, FALSE)
	return
}

//-----------------------------------------------------

script Meta_KogaElbow_TriggerScript_CompletePuzzle {
	lock
	setmetatile(21, 21, METATILE_TrickHousePuzzle_Button_Pressed, FALSE)
	set_meta_visited_flag(MAP_META_KOGA_ELBOW)
	playse (SE_PIN)
	delay(40)
	
	call (Meta_KogaElbow_PlaceTopShortcut)
	special(DrawWholeMapView)
	playse (SE_M_STRENGTH)
	setvar (VAR_0x8004, 2)  #amplitude y
	setvar (VAR_0x8005, 0)  #amplitude x
	setvar (VAR_0x8006, 2)  #duration (num shakes)
	setvar (VAR_0x8007, 5)  #frequency
	special (ShakeCamera)
	waitstate
	
	call (Meta_KogaElbow_PlaceSideShortcut)
	special(DrawWholeMapView)
	playse (SE_M_STRENGTH)
	setvar (VAR_0x8004, 2)  #amplitude y
	setvar (VAR_0x8005, 0)  #amplitude x
	setvar (VAR_0x8006, 2)  #duration (num shakes)
	setvar (VAR_0x8007, 5)  #frequency
	special (ShakeCamera)
	waitstate
	setvar(VAR_TEMP_0, 1)
	release
}

script Meta_KogaElbow_TriggerScript_CheckpointLocation {
	// getplayerxy(VAR_INTERACT_X, VAR_INTERACT_Y)
	// setwarp(WARPTYPE_AUXILIARY, MAP_META_KOGA_ELBOW, -1, VAR_INTERACT_X, VAR_INTERACT_Y)
	setwarp(WARPTYPE_AUXILIARY, MAP_META_KOGA_ELBOW)
	// release
}

//-----------------------------------------------------

script Meta_KogaElbow_EventScript_Azumarill {
	msgbox ("This Azumarill seems to be giggling\n"
			"menacingly.$", MSGBOX_AUTOCLOSE)
}

script Meta_KogaElbow_EventScript_Tustin {
	trainerbattle_single(TRAINER_01,
			"Okay, you're not getting by that easily!\n"
			"Time for a Secret Dev Boss Battle!$",
			"I don't know what I expected. I'm\n"
			"terrible at competitive battling.$")
	msgbox ("Really, I just wanted to use the custom\n"
			"trainer sprite I made for myself.\l"
			"I made it like ten years ago for kicks.$", MSGBOX_AUTOCLOSE)
}

script Meta_KogaElbow_EventScript_CameraMan {
	msgbox ("You're on candid camera! Smile!$", MSGBOX_AUTOCLOSE)
}

script Meta_KogaElbow_EventScript_GBAKid {
	msgbox ("I was told by Ms. Flannery to stand\n"
			"here and stare in this direction.\p"
			"It's a good thing I brought my game\n"
			"'cause this is BORING!$", MSGBOX_AUTOCLOSE)
}

script Meta_KogaElbow_EventScript_Nurse {
	msgbox ("If you're expecting some healing,\n"
			"you're out of luck. I'm out of potions.$", MSGBOX_AUTOCLOSE)
}

script Meta_KogaElbow_EventScript_Mart {
	msgbox ("I also gave away my last potion. Sorry.$", MSGBOX_AUTOCLOSE)
}

script Meta_KogaElbow_EventScript_Camper {
	trainerbattle_single(TRAINER_02,
			"So like, getting paid to just stand\n"
			"here is cool and all…\p"
			"But I just got back from Alola, so I\n"
			"wanna show off some of my cool 'mon!$",
			"I wonder if I get paid extra for\n"
			"doing this battle?$")
	msgbox ("A job's a job, right?$", MSGBOX_AUTOCLOSE)
}

script Meta_KogaElbow_EventScript_Bard {
	msgbox ("(This guy seems to be meditating.)$", MSGBOX_AUTOCLOSE)
}

script Meta_KogaElbow_EventScript_MaskedKid {
	trainerbattle_single(TRAINER_03,
			"My mom grounded me because of you!\n"
			"We only stole your {POKEMON} as a prank!$",
			"Waaaaaahhhhhhh!!!!$")
	msgbox ("My mom's forcing me to be here\n"
			"as punishment.\p"
			"It was just a prank!\n"
			"You're not supposed to get mad…$", MSGBOX_AUTOCLOSE)
}

