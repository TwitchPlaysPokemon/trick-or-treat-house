raw `
#define LID_FLANNERY 10
#define LID_SCROLL 11

Meta_LavaridgeSprings_MapScripts::
	puzzle_info Puzzle_MetaPuzzle_Name, CommonAuthor_Tustin2121
	map_script MAP_SCRIPT_ON_TRANSITION, Meta_LavaridgeSprings_OnTransition
	map_script MAP_SCRIPT_ON_LOAD, Meta_LavaridgeSprings_OnLoad
	.byte 0
`

script(local) Meta_LavaridgeSprings_OnTransition {
	set_meta_visited_flag(MAP_META_LAVARIDGE_SPRINGS)
}

script(local) Meta_LavaridgeSprings_OnLoad {
	if (var(VAR_GRID_SIZE) == GRID_SIZE_1x2) {
		setobjectxyperm(LID_FLANNERY, 100, 100) // move off map
	}
	if (var(VAR_LOC_SCROLL) != MAP_META_LAVARIDGE_SPRINGS) {
		setobjectxyperm(LID_SCROLL, 100, 100) // move off map
	}
}

script Meta_LavaridgeSprings_EventScript_Flannery {
	if (!flag(FLAG_TEMP_1)) {
		msgbox( "This is amazing! Thank you for making\n"
				"this dream come true!\p"
				"What sort of puzzle is this? Well,\n"
				"why don't you check out the pedestal\l"
				"to my left and find out! Hehe!$", MSGBOX_NPC)
		setflag(FLAG_TEMP_1)
	} else {
		msgbox( "I'll give you a hint: The Final Bluff?\n"
				"The room marked by the rock icon?\p"
				"That's where the exit door is.\p"
				"But you're gonna need a bunch of things\n"
				"to get to the top of that room!$", MSGBOX_NPC)
	}
}

script Meta_LavaridgeSprings_EventScript_TestOpen {
	lock
	playse(SE_PIN)
	setmetatile(19, 9, 0x271, 0)
	setmetatile(20, 9, 0x271, 0)
	setmetatile(19, 8, 0x071, 0)
	setmetatile(20, 8, 0x071, 0)
	setmetatile(19, 0, 0x001, 0)
	setmetatile(20, 0, 0x001, 0)
	setmetatile(19, -1, 0x001, 0)
	setmetatile(20, -1, 0x001, 0)
	setmetatile(19, -2, 0x001, 0)
	setmetatile(20, -2, 0x001, 0)
	
	setmetatile(9, 19, 0x271, 0)
	setmetatile(9, 20, 0x271, 0)
	setmetatile(8, 19, 0x071, 0)
	setmetatile(8, 20, 0x071, 0)
	setmetatile(0, 19, 0x001, 0)
	setmetatile(0, 20, 0x001, 0)
	setmetatile(-1, 19, 0x001, 0)
	setmetatile(-1, 20, 0x001, 0)
	setmetatile(-2, 19, 0x001, 0)
	setmetatile(-2, 20, 0x001, 0)
	callnative(DrawWholeMapView)
	release
}

