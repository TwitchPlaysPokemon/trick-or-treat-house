script Meta_ZipSlide_TriggerScript_CompletePuzzle {
	lock
	setmetatile(19, 7, METATILE_TrickHousePuzzle_Button_Pressed, FALSE)
	setmetatile(11, 21, METATILE_TrickHousePuzzle_Door_Shuttered, FALSE)
	setmetatile(28, 21, METATILE_TrickHousePuzzle_Door_Shuttered, FALSE)
	set_meta_visited_flag(MAP_META_ZIP_SLIDE)
	playse (SE_PIN)
	setvar(VAR_TEMP_0, 1)
	callnative(DrawWholeMapView)
	release
}
