raw `
Puzzle_PacketLost_MapScripts::
	puzzle_info Puzzle_PacketLost_Name, Puzzle_PacketLost_Author
	puzzle_adjective Puzzle_PacketLost_Adjective
	puzzle_quip Puzzle_PacketLost_Quip
	puzzle_candylist Puzzle_PacketLost_CandyList
	puzzle_metavars Puzzle_PacketLost_Variables
    map_script MAP_SCRIPT_ON_PUZZLE_SETUP, Puzzle_PacketLost_SetupPuzzle
	map_script MAP_SCRIPT_ON_RESUME, Puzzle_PacketLost_OnResume
	map_script MAP_SCRIPT_ON_LOAD, Puzzle_PacketLost_OnLoad
	map_script MAP_SCRIPT_ON_FRAME_TABLE, Puzzle_PacketLost_FrameTable
	.byte 0

Puzzle_PacketLost_Name:
	.string "Packet Lost$"
Puzzle_PacketLost_Author:
	.string "MyRattata$"
Puzzle_PacketLost_Adjective:
	.string "technological$"
Puzzle_PacketLost_Quip:
	.string "I don't know if I should be sad\n"
	.string "that I wasn't paid, or happy\l"
	.string "to get work experience…$"
.align 2
Puzzle_PacketLost_Variables:
	.2byte VAR_QUIP_PERSON, OBJ_EVENT_GFX_LASS
Puzzle_PacketLost_CandyList:
	.2byte FLAG_CANDY_ABUNDANT_01
	.2byte FLAG_CANDY_ABUNDANT_02
	.2byte FLAG_CANDY_COMMON_01
	.2byte FLAG_CANDY_COMMON_02
	.2byte FLAG_CANDY_COMMON_03
	.2byte FLAG_CANDY_UNCOMMON_01
	.2byte FLAG_CANDY_UNCOMMON_02
	.2byte FLAG_CANDY_UNCOMMON_03
	.2byte FLAG_CANDY_RARE_01
	.2byte 0
	
Puzzle_PacketLost_FrameTable:
	@ VAR_STEP_TRIGGER is set to 1 by MonitorMultiObjectEventTriggersStepCallback when any npc steps on a trigger
	map_script_2 VAR_STEP_TRIGGER, 1, Puzzle_PacketLost_TurnFinish
	map_script_2 VAR_TEMP_4, 1, Puzzle_PacketLost_AutoPostBattle
	.2byte 0
Puzzle_PacketLost_OnResume:
	@ Setup the NPC Trigger step callback MonitorObjectEventTriggersStepCallback
	setnpctriggercallback NPC_TRIGGER_CB_COPY_MOVEMENT 
	end
`	
// -----------------------------------------------------

script Puzzle_PacketLost_SetupPuzzle {
	setflag (FLAG_PUZZLE_21)
	hideobjectat(14, MAP_PUZZLE_PACKET_LOST)
}

script Puzzle_PacketLost_OnLoad {
	setflag (FLAG_TEMP_1)
	setflag (FLAG_TEMP_3)
	setflag (FLAG_TEMP_4)
	hideobjectat(5, MAP_PUZZLE_PACKET_LOST)
	setvar(VAR_STEP_TRIGGER, 0)
	setvar(VAR_TEMP_2, 0)
	if (flag(FLAG_PUZZLE_23) == TRUE) {
		setmetatile (5, 11, 0x219, 0)
		setmetatile (6, 11, 0x219, 0)
		special(DrawWholeMapView)
	}
}
// -----------------------------------------------------
script Puzzle_PacketLost_Arrive {
	if (flag(FLAG_TEMP_7) == FALSE && flag(FLAG_TEMP_8) == FALSE && flag(FLAG_PUZZLE_20) == FALSE) {
		setflag(FLAG_TEMP_8)
		special (SpawnCameraObject)
		applymovement(OBJ_EVENT_ID_CAMERA, Puzzle_PacketLost_CameraUp)
		waitmovement(OBJ_EVENT_ID_CAMERA)
		special (RemoveCameraObject)
		applymovement(5, Puzzle_PacketLost_JumpOutPC)
		playse(SE_LEDGE)
		waitmovement(5)
		playmoncry(SPECIES_PORYGON2, CRY_MODE_NORMAL)
		waitmoncry
		applymovement(5, Puzzle_PacketLost_PuzzleWalk)
		waitmovement(5)
		speakername("Serges")
		msgbox("Testing… Now!$")
		copyobjectxytoperm(5)
		setobjectmovementtype(5, MOVEMENT_TYPE_WALK_SEQUENCE_PORY2)
		removeobject(5)
		addobject(5)
		releaseall
	} else {
		releaseall
	}
	end
}

script Puzzle_PacketLost_TurnFinish {
	if(flag(FLAG_TEMP_10) == FALSE) {
		setflag(FLAG_TEMP_10)
		setflag(FLAG_TEMP_11)
		setobjectxy(5, 31, 4)
		applymovement(5, Puzzle_PacketLost_WalkDown)
		waitmovement(5)
		copyobjectxytoperm(5)
		setobjectmovementtype(5, MOVEMENT_TYPE_ROTATE_CLOCKWISE)
		removeobject(5)
		addobject(5)
		setvar(VAR_TEMP_2, 2)
		setvar(VAR_STEP_TRIGGER, 2)
		playse(SE_SUCCESS)
		waitmovement(5)
		releaseall
		return
	} else {
		setvar(VAR_STEP_TRIGGER, 2)
		releaseall
		return
	}
		return
}

script Puzzle_PacketLost_Leave {
	clearflag(FLAG_TEMP_8)
	warpteleport(MAP_PUZZLE_PACKET_LOST, 255, 3, 19)
	releaseall
	end
}

script Puzzle_PacketLost_Button1 {
	if (flag(FLAG_TEMP_A) == FALSE) {
		playse (SE_PIN)
		setmetatile (44, 5, 0x2AD, 0)
		setflag(FLAG_TEMP_A)
		special(DrawWholeMapView)
	}
	releaseall
	end
}

script Puzzle_PacketLost_Button2 {
	playse (SE_PIN)
	if (flag(FLAG_TEMP_B) == FALSE) {
		setmetatile (39, 5, 0x2AD, 0)
		setmetatile (38, 4, 0x2AC, 1)
		setflag(FLAG_TEMP_B)
	} else {
		setmetatile (39, 5, 0x2AC, 1)
		setmetatile (38, 4, 0x2AD, 0)
		clearflag(FLAG_TEMP_B)
	}
	special(DrawWholeMapView)
	releaseall
	end
}

script Puzzle_PacketLost_Button3 {
	if (flag(FLAG_TEMP_C) == FALSE) {
		playse (SE_PIN)
		setmetatile (35, 5, 0x2AD, 0)
		setflag(FLAG_TEMP_C)
		special(DrawWholeMapView)
	}
	releaseall
	end
}

script Puzzle_PacketLost_Button4 {
	if (flag(FLAG_TEMP_D) == FALSE) {
		playse (SE_PIN)
		setmetatile (32, 4, 0x2AD, 0)
		setflag(FLAG_TEMP_D)
		special(DrawWholeMapView)
	}
	releaseall
	end
}

script Puzzle_PacketLost_Button5 {
	if (flag(FLAG_TEMP_6) == TRUE && flag(FLAG_TEMP_7) == FALSE && flag(FLAG_TEMP_11) == TRUE && flag(FLAG_PUZZLE_20) == FALSE) {
		playse (SE_PIN)
		setmetatile (25, 7, 0x2AD, 0)
		setflag(FLAG_TEMP_7)
		setobjectmovementtype(6, MOVEMENT_TYPE_FACE_DOWN)
		removeobject(6)
		addobject(6)
		special(DrawWholeMapView)
	} elif (flag(FLAG_TEMP_6) == TRUE && flag(FLAG_PUZZLE_20) == TRUE) {
		playse (SE_PIN)
		setmetatile (25, 7, 0x2AD, 0)
		setmetatile(24, 5, 0x30B, 1)
		special(DrawWholeMapView)
	}  elif (flag(FLAG_TEMP_6) == TRUE && flag(FLAG_TEMP_7) == FALSE && flag(FLAG_TEMP_11) == FALSE) {
		playse (SE_BOO)
	}
	releaseall
	end
}

script Puzzle_PacketLost_ButtonLights1 {
	if (flag(FLAG_TEMP_6) == FALSE) {
		playse (SE_PIN)
		call(Puzzle_PacketLost_LightsOut1)
		call(Puzzle_PacketLost_LightsOut2)
		call(Puzzle_PacketLost_EventScript_CheckAnswer)
		special(DrawWholeMapView)
	}
	releaseall
	end
}

script Puzzle_PacketLost_ButtonLights2 {
	if (flag(FLAG_TEMP_6) == FALSE) {
	playse (SE_PIN)
		call(Puzzle_PacketLost_LightsOut1)
		call(Puzzle_PacketLost_LightsOut2)
		call(Puzzle_PacketLost_LightsOut3)
		call(Puzzle_PacketLost_EventScript_CheckAnswer)
		special(DrawWholeMapView)
	}
	releaseall
	end
}

script Puzzle_PacketLost_ButtonLights3 {
	if (flag(FLAG_TEMP_6) == FALSE) {
	playse (SE_PIN)
		call(Puzzle_PacketLost_LightsOut2)
		call(Puzzle_PacketLost_LightsOut3)
		call(Puzzle_PacketLost_LightsOut4)
		call(Puzzle_PacketLost_EventScript_CheckAnswer)	
	}
	special(DrawWholeMapView)
	releaseall
	end
}

script Puzzle_PacketLost_ButtonLights4 {
	if (flag(FLAG_TEMP_6) == FALSE) {
	playse (SE_PIN)
		call(Puzzle_PacketLost_LightsOut3)
		call(Puzzle_PacketLost_LightsOut4)
		call(Puzzle_PacketLost_LightsOut5)
		call(Puzzle_PacketLost_EventScript_CheckAnswer)
		special(DrawWholeMapView)
	}
	releaseall
	end
}

script Puzzle_PacketLost_ButtonLights5 {
	if (flag(FLAG_TEMP_6) == FALSE) {
		playse (SE_PIN)
		call(Puzzle_PacketLost_LightsOut4)
		call(Puzzle_PacketLost_LightsOut5)
		call(Puzzle_PacketLost_EventScript_CheckAnswer)
