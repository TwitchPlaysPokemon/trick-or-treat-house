	setmetatile (28, 4, 0x2AC, 1)
	setmetatile (28, 5, 0x2AC, 1)
	setmetatile (28, 6, 0x2AC, 1)
	clearflag (FLAG_TEMP_3)
	return
}

script Puzzle_PacketLost_EventScript_Green4 {
	setmetatile (27, 4, 0x2AD, 0)
	setmetatile (27, 5, 0x2AD, 0)
	setmetatile (27, 6, 0x2AD, 0)
	setflag (FLAG_TEMP_4)
	return
}

script Puzzle_PacketLost_EventScript_Red4 {
	setmetatile (27, 4, 0x2AC, 1)
	setmetatile (27, 5, 0x2AC, 1)
	setmetatile (27, 6, 0x2AC, 1)
	clearflag (FLAG_TEMP_4)
	return
}

script Puzzle_PacketLost_EventScript_Green5 {
	setmetatile (26, 4, 0x2AD, 0)
	setmetatile (26, 5, 0x2AD, 0)
	setmetatile (26, 6, 0x2AD, 0)
	setflag (FLAG_TEMP_5)
	return
}

script Puzzle_PacketLost_EventScript_Red5 {
