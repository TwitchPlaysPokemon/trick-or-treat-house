}

script Puzzle_PacketLost_ButtonMag1 {
	if (flag(FLAG_TEMP_E) == FALSE) {
		playse (SE_PIN)
		msgbox("The remote-control Magnemite toy\n"
		"turns on!$", MSGBOX_AUTOCLOSE)
		setobjectmovementtype(3, MOVEMENT_TYPE_COPY_PLAYER)
		removeobject(3)
		addobject(3)
		setflag(FLAG_TEMP_E)
	}
	releaseall
	end
}

script Puzzle_PacketLost_ButtonMag2 {
	if (flag(FLAG_TEMP_F) == FALSE) {
		playse (SE_PIN)
		msgbox("The remote-control Magnemite toy\n"
		"turns on!$", MSGBOX_AUTOCLOSE)
		setobjectmovementtype(4, MOVEMENT_TYPE_COPY_PLAYER)
		removeobject(4)
		addobject(4)
		setflag(FLAG_TEMP_F)
	}
	releaseall
	end
}

script Puzzle_PacketLost_LightsOut1 {
	if (flag(FLAG_TEMP_1) == FALSE) {
		call(Puzzle_PacketLost_EventScript_Green1)
	} else {
		call(Puzzle_PacketLost_EventScript_Red1)
	}
	return
}

script Puzzle_PacketLost_LightsOut2 {
	if (flag(FLAG_TEMP_2) == FALSE) {
		call(Puzzle_PacketLost_EventScript_Green2)
	} else {
		call(Puzzle_PacketLost_EventScript_Red2)
	}
	return
}

script Puzzle_PacketLost_LightsOut3 {
	if (flag(FLAG_TEMP_3) == FALSE) {
		call(Puzzle_PacketLost_EventScript_Green3)
	} else {
		call(Puzzle_PacketLost_EventScript_Red3)
	}
	return
}

script Puzzle_PacketLost_LightsOut4 {
	if (flag(FLAG_TEMP_4) == FALSE) {
		call(Puzzle_PacketLost_EventScript_Green4)
	} else {
		call(Puzzle_PacketLost_EventScript_Red4)
	}
	return
}

script Puzzle_PacketLost_LightsOut5 {
	if (flag(FLAG_TEMP_5) == FALSE) {
		call(Puzzle_PacketLost_EventScript_Green5)
	} else {
		call(Puzzle_PacketLost_EventScript_Red5)
	}
	return
}

script Puzzle_PacketLost_EventScript_Green1 {
	setmetatile (30, 4, 0x2AD, 0)
	setmetatile (30, 5, 0x2AD, 0)
	setmetatile (30, 6, 0x2AD, 0)
	setflag (FLAG_TEMP_1)
	return
}

script Puzzle_PacketLost_EventScript_Red1 {
	setmetatile (30, 4, 0x2AC, 1)
	setmetatile (30, 5, 0x2AC, 1)
	setmetatile (30, 6, 0x2AC, 1)
	clearflag (FLAG_TEMP_1)
	return
}

script Puzzle_PacketLost_EventScript_Green2 {
	setmetatile (29, 4, 0x2AD, 0)
	setmetatile (29, 5, 0x2AD, 0)
	setmetatile (29, 6, 0x2AD, 0)
	setflag (FLAG_TEMP_2)
	return
}

script Puzzle_PacketLost_EventScript_Red2 {
	setmetatile (29, 4, 0x2AC, 1)
	setmetatile (29, 5, 0x2AC, 1)
	setmetatile (29, 6, 0x2AC, 1)
	clearflag (FLAG_TEMP_2)
	return
}

script Puzzle_PacketLost_EventScript_Green3 {
	setmetatile (28, 4, 0x2AD, 0)
	setmetatile (28, 5, 0x2AD, 0)
	setmetatile (28, 6, 0x2AD, 0)
	setflag (FLAG_TEMP_3)
	return
}

