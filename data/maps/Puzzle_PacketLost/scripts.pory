	setmetatile (26, 5, 0x2AC, 1)
	setmetatile (26, 6, 0x2AC, 1)
	clearflag (FLAG_TEMP_5)
	return
}

script Puzzle_PacketLost_EventScript_CheckAnswer {
	if (flag(FLAG_TEMP_1) == TRUE && flag(FLAG_TEMP_2) == TRUE && flag(FLAG_TEMP_3) == TRUE && flag(FLAG_TEMP_4) == TRUE && flag(FLAG_TEMP_5) == TRUE) {
		playse(SE_SUCCESS)
		setmetatile (25, 9, 0x2AE, 0)
		setflag(FLAG_TEMP_6)
	}
	return
}

movement Puzzle_PacketLost_JumpOutPC {
	jump_2_left
	face_up
	face_right
	face_down
	face_left
}

movement Puzzle_PacketLost_PuzzleWalk {
	walk_down
	walk_left
}

movement Puzzle_PacketLost_Left {
	face_left
}

movement Puzzle_PacketLost_Down {
	face_down
}

movement Puzzle_PacketLost_WalkDown {
	walk_down
}

movement Puzzle_PacketLost_Up {
	face_up
}

movement Puzzle_PacketLost_JumpInPC {
	walk_left * 5
	jump_2_left
}

movement Puzzle_PacketLost_CameraUp {
	walk_up * 2
}

movement Puzzle_PacketLost_CameraDown {
	walk_down * 2
}

movement Puzzle_PacketLost_ShutPanel {
	walk_up * 2
}

movement Puzzle_PacketLost_CompOn {
	walk_up
	face_left
}

movement Puzzle_PacketLost_SeeTeleport {
	walk_right * 3
	walk_down * 4
}

movement Puzzle_PacketLost_ReturnTeleport {
	walk_up * 4
	walk_left * 3
}

//----------------------------------------------------------

script Puzzle_PacketLost_Trainer1 {
	#
	trainerbattle_single (TRAINER_01,
			"Do you mind? I'm in the middle of \n"
			"debugging, and you keep pressing things.$",
			"Great. That delayed testing by about\n"
			"20 minutes.$")
				speakername("Bugmann")
				msgbox("Goodbye.$", MSGBOX_NPC)
				setobjectmovementtype(6, MOVEMENT_TYPE_FACE_LEFT)
				removeobject(6)
				addobject(6)
				releaseall
				end
}
				
				
script Puzzle_PacketLost_AutoPostBattle	{	
	if (flag(FLAG_PUZZLE_20) == FALSE) {
		speakername("Bugmann")
		msgbox("So, you were asked to do a live test?\n"
			"If that was true, wouldn't I have seen\l"
			"a Porygon2 navigating the course?$", MSGBOX_NPC)
		special (SpawnCameraObject)
		applymovement(6, Puzzle_PacketLost_Up)
		playmoncry(SPECIES_PORYGON2, CRY_MODE_NORMAL)
		waitmoncry
		applymovement(5, Puzzle_PacketLost_JumpInPC)
		delay(60)
		playse(SE_LEDGE)
		waitmovement(5)
		copyobjectxytoperm(5)
		hideobjectat(5, MAP_PUZZLE_PACKET_LOST)
		applymovement(OBJ_EVENT_ID_CAMERA, Puzzle_PacketLost_CameraDown)
		waitmovement(OBJ_EVENT_ID_CAMERA)
		special (RemoveCameraObject)
		applymovement(6, Puzzle_PacketLost_Down)
		speakername("Bugmann")
		msgbox("Ok, listen. If I give you this can we\n"
			"pretend that we didn't have this\l"
			"conversation here?$", MSGBOX_NPC)
		giveitem_std(ITEM_TABLE_CANDY_RARE, 1)
		setflag(FLAG_CANDY_RARE_01)
		speakername("Bugmann")
		message("Excellent.$, MSGBOX_NPC")
		waitmessage
		applymovement(6, Puzzle_PacketLost_ShutPanel)
		waitmovement(6)
		setmetatile(24, 5, 0x30B, 1)
		special(DrawWholeMapView)
		applymovement(6, Puzzle_PacketLost_CompOn)
		waitmovement(6)
		copyobjectxytoperm(6)
		setflag(FLAG_PUZZLE_20)
		clearflag(FLAG_PUZZLE_21)
		setvar(VAR_TEMP_4, 3) 
		speakername("Bugmann")
		msgbox("Goodbye.$", MSGBOX_NPC)
		setobjectmovementtype(6, MOVEMENT_TYPE_FACE_LEFT)
		removeobject(6)
		addobject(6)
		releaseall
		end
	} else {
		releaseall
	}
	end
}

//----------------------------------------------------------

script Puzzle_PacketLost_MovingRock {
	msgbox ("It's a boulder that moves on it's own.\n"
			"Apparently, these are notorious\l"
			"in a region called… Tohoak?$", MSGBOX_AUTOCLOSE)
}

script Puzzle_PacketLost_MagnemiteDrone1 {
	if (flag(FLAG_CANDY_UNCOMMON_01) == FALSE) {
		msgbox ("It's a remote-control Magnemite toy.\n"
				"Something is attached to the magnets.$", MSGBOX_AUTOCLOSE)
		giveitem_std(ITEM_TABLE_CANDY_UNCOMMON, 1)
		setflag(FLAG_CANDY_UNCOMMON_01)
		msgbox ("How did that get there?$", MSGBOX_AUTOCLOSE)
	} else {
	msgbox ("It's a remote-control Magnemite toy.$", MSGBOX_AUTOCLOSE)
	}
}

script Puzzle_PacketLost_MagnemiteDrone2 {
	msgbox ("It's the other remote-control Magnemite toy.$", MSGBOX_AUTOCLOSE)
}

script Puzzle_PacketLost_NPCRocket {
	msgbox ("What?\p"
			"It's Halloween.\p"
			"I can wear a costume to work.$", MSGBOX_NPC)
}

script Puzzle_PacketLost_NPCComputerWoman {
	msgbox ("These computers were designed for data\n"
			"transfer. We bought them second-hand\l"
			"from the Cable Club.\p"
			"Apparently, kids these days don't\n"
			"mix records as often.$", MSGBOX_NPC)
}

script Puzzle_PacketLost_SignFreeComputer {
	msgbox ("It's a computer, showing a message.\n"
			"“Transport under maintenance.”$", MSGBOX_AUTOCLOSE)
}

script Puzzle_PacketLost_PoryOut {
	msgbox ("It's the Porygon2 from earlier!\n"
			"It's carrying a scroll.$", MSGBOX_NPC)
	call(PuzzleCommon_EventScript_Scroll)
	releaseall
	end
}

script Puzzle_PacketLost_NPCScientist {
	if (flag(FLAG_PUZZLE_22) == FALSE) {
		msgbox ("The scientist seems very focused on…\n"
				"Whatever that is on screen.$", MSGBOX_SIGN)
	} elif (flag(FLAG_PUZZLE_22) == TRUE && flag(FLAG_PUZZLE_20) == FALSE && flag(FLAG_PUZZLE_23) == FALSE) {
		playbgm(MUS_ENCOUNTER_SUSPICIOUS, FALSE)
		speakername("Serges")
		msgbox("Oh, a kid? Uhh… Did you want to battle?$", MSGBOX_NPC)
		trainerbattle_no_intro (TRAINER_02,
			"Ah, you're here to help with testing.$")
			speakername("Serges")
			msgbox ("So, the scroll you're looking for? \n"
					"I digitized it and sent it to storage.\p"
					"Not to worry, this is just so we can do\n"
					"a live test of the Physical E-Mail system.\p"
					"What is that, you might have asked?\n"
					"No, it is not just “regular mail.”\p"
					"We use computers to send a {POKEMON}-\n"
					"specifically a Porygon2 holding mail and\l"
					"parcels, to the nearest suitable PC.\p"
					"It carries the delivery onward to the\n"
					"recipient, saving time without requiring\l"
					"every home to set up a PC capable of\l"
					"sending and receiving {POKEMON}.\p"
					"At least, that's the theory.$", MSGBOX_NPC)
		special (SpawnCameraObject)
		applymovement(OBJ_EVENT_ID_CAMERA, Puzzle_PacketLost_SeeTeleport)
		waitmovement(OBJ_EVENT_ID_CAMERA)
		setmetatile (5, 11, 0x219, 0)
		setmetatile (6, 11, 0x219, 0)
		special(DrawWholeMapView)
		speakername("Serges")
  		msgbox ("Through there is our Porygon2 training\n"
				"course. Right now, it only knows the\l"
				"basics of navigation.\p"
				"Your role is to use the panels to clear\n"
				"the path to the other PC for it.\p"
				"Porygon2 should be able to observe how\n"
				"obstacles it could face may behave\l"
				"and how you solve problems.\p"
				"If it gets stuck, just exit and re-enter.\n"
				"In this facility we can reset it remotely.$", MSGBOX_NPC)
		applymovement(OBJ_EVENT_ID_CAMERA, Puzzle_PacketLost_ReturnTeleport)
		waitmovement(OBJ_EVENT_ID_CAMERA)
		special (RemoveCameraObject)
		setflag(FLAG_PUZZLE_23)
		speakername("Serges")
  			msgbox ("Best of luck!$", MSGBOX_NPC)
		releaseall
		end
	} elif (flag(FLAG_PUZZLE_22) == TRUE && flag(FLAG_PUZZLE_20) == FALSE && flag(FLAG_PUZZLE_23) == TRUE) {
		speakername("Serges")
  		msgbox ("Best of luck!$", MSGBOX_NPC)
		releaseall
		end
	} elif (flag(FLAG_PUZZLE_22) == TRUE && flag(FLAG_PUZZLE_20) == TRUE && flag(FLAG_PUZZLE_23) == TRUE && flag(FLAG_CANDY_UNCOMMON_03) == FALSE) {
		speakername("Serges")
  		msgbox ("Great work! That should make fine\n"
		"training data. Here, take this.$", MSGBOX_NPC)
		giveitem_std(ITEM_TABLE_CANDY_UNCOMMON, 3)
		setflag(FLAG_CANDY_UNCOMMON_03)
		releaseall
		end
	} else {
	speakername("Serges")
  		msgbox ("Bugmann didn't cause you any trouble,\n"
		"did he?$", MSGBOX_NPC)
		releaseall
		end
	} 
}
	
script Puzzle_PacketLost_NPCScienceBoss {
	msgbox ("Hello! Welcome to the computer lab!\n"
  			"You're here for tests and puzzles, yes?\l"
  			"Then Serges at the green PC is your man.$", MSGBOX_NPC)
	setflag(FLAG_PUZZLE_22)
	releaseall
	end
}