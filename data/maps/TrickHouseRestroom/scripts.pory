script TrickHouseRestroom_EventScript_VisitorJames {
	if (var(VAR_TEMP_B) == 1) {
		msgbox("{LINK}: This could be the best idea\n"
				"you've ever had, {JOEY}.\p"
				"Think of all the places we can go\n"
				"trick or treating at…$", MSGBOX_SIGN)
	}
}
