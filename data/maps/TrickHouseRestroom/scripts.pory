mapscripts TrickHouseRestroom_MapScripts {
	MAP_SCRIPT_ON_LOAD {
		// See scenes.pory
		call(TrickHouseRestroom_OnLoad_Breeder)
		call(TrickHouseRestroom_OnLoad_Birch)
		call(TrickHouseRestroom_OnLoad_Friends)
		call(TrickHouseRestroom_OnLoad_CleanupDuplicates)
	}
}

// ----------------------------------------------------
// Counter people

script TrickHouseRestroom_EventScript_Healer {
	msgbox ("Hello there. Would you like me to\n"
			"heal your {POKEMON}?$", MSGBOX_YESNO)
	if (var(VAR_RESULT) == YES) {
		incrementgamestat(GAME_STAT_USED_POKECENTER)
		msgbox ("Alright, dearie. Let me have your\n"
				"{POKEMON} for a moment.\p"
				"The healing machine is in the back\n"
				"room, so let me get my cane here…\p"
				"Sit tight a moment.$")
		closemessage
		applymovement(1, TrickHouseRestroom_Movement_Healer_lady10)
		waitmovement (1)
		special (SpawnCameraObject)
		applymovement(LID_PLAYER, TrickHouseRestroom_Movement_Healer_player11)
		applymovement(LID_FOLLOWER, TrickHouseRestroom_Movement_Healer_follower11)
		waitmovement (LID_PLAYER)
		applymovement(LID_PLAYER, TrickHouseRestroom_Movement_Healer_player12)
		applymovement(LID_FOLLOWER, TrickHouseRestroom_Movement_Healer_follower12)
		playse (SE_LEDGE)
		waitmovement (LID_PLAYER)
		applymovement(LID_PLAYER, TrickHouseRestroom_Movement_Healer_player13)
		playfanfare(MUS_HEAL)
		special(HealPlayerParty)
		waitfanfare
		applymovement(1, TrickHouseRestroom_Movement_Healer_lady20)
		waitmovement (LID_PLAYER)
		applymovement(LID_FOLLOWER, Common_Movement_WalkUp1)
		waitmovement (1)
		special (RemoveCameraObject)
		msgbox ("Here you are, dearie. Your {POKEMON}\n"
				"are so well behaved.\p"
				"Good luck with the puzzles!$")
		release
	} else {
		msgbox ("Good luck, dearie.$")
		release
	}
}
movement TrickHouseRestroom_Movement_Healer_lady10 {
	delay_16 * 2
	face_left
	delay_16 * 3
	face_right
	delay_16 * 2
	face_up
	delay_16 * 3
	walk_slow_up
	set_invisible
	delay_16 * 5
}
movement TrickHouseRestroom_Movement_Healer_player11 {
	face_right
	delay_16 * 3
	face_down
	delay_16 * 2
	face_up
	lock_facing_direction
	walk_down
	unlock_facing_direction
	delay_16 * 4
}
movement TrickHouseRestroom_Movement_Healer_follower11 {
	delay_16 * 2
	face_down
	delay_16 * 2
	face_up
	delay_8
	lock_facing_direction
	walk_down
	unlock_facing_direction
}
movement TrickHouseRestroom_Movement_Healer_player12 {
	jump_in_place_up
	delay_16 * 4
	walk_slow_left
	walk_slow_up
	walk_slow_right * 2
	walk_slow_down
	walk_slow_left * 2
	walk_slow_up
	walk_slow_right * 2
}
movement TrickHouseRestroom_Movement_Healer_follower12 {
	delay_16 * 6
	face_left
	delay_16 * 3
	face_right
	delay_16 * 4
	face_left 
	delay_16 * 4
	face_down
	delay_16 * 5
	face_up
	delay_16 * 4
	face_left 
	delay_16 * 4
	face_down
	delay_16 * 5
	face_right
}
movement TrickHouseRestroom_Movement_Healer_player13 {
	walk_slow_down
	walk_slow_left * 2
	walk_slow_up
	walk_slow_right * 2
	walk_in_place_up
	delay_16 * 4
	walk_fast_left
	walk_in_place_up
}
movement TrickHouseRestroom_Movement_Healer_lady20 {
	delay_16 * 5
	face_down
	set_visible
	walk_slow_down
	delay_16 * 2
	face_right
	delay_16 * 3
	face_left
	delay_16 * 2
	face_down
	delay_16 * 2
	step_end
}



script TrickHouseRestroom_EventScript_Relearner {
	lock
	msgbox ("I'm the MOVE REMINDER.\p"
			"I can teach moves that your {POKEMON}\n"
			"may have forgotten.\p"
			"Would you like to teach one of your\n"
			"{POKEMON} a forgotten move?$", MSGBOX_YESNO)
	if (var(VAR_RESULT) == NO) {
		msgbox ("Good luck on the puzzles.$")
		release
		end
	}
	goto(TrickHouseRestroom_EventScript_Relearner_Choose)
}
script TrickHouseRestroom_EventScript_Relearner_Choose {
	special (ChooseMonForMoveRelearner)
	waitstate
	if (var(VAR_0x8004) == 255) {
		msgbox ("Good luck on the puzzles.$")
		release
		end
	}
	elif (var(VAR_0x8005) == 0) {
		msgbox ("Sorry…\p"
				"It doesn't appear as if I have any moves\n"
				"I can teach that POKéMON.$")
		goto(TrickHouseRestroom_EventScript_Relearner_Choose)
		end
	}
	msgbox ("Which move should I teach?$")
	special(TeachMoveRelearnerMove)
	waitstate
	if (var(VAR_0x8004) == 0) {
		msgbox ("Want me to teach anyone else?$")
		goto(TrickHouseRestroom_EventScript_Relearner_Choose)
		end
	}
	msgbox ("Good luck on the puzzles.$")
	release
}


script TrickHouseRestroom_EventScript_Renamer {
	lock
	msgbox( "Hi, hi! I'm the NAME RATER!\n"
			"I'm the fortune-teller of names!\p"
			"I shall be pleased to rate your\n"
			"POKéMON's nickname.$", MSGBOX_YESNO)
	if (var(VAR_RESULT) == YES) {
		msgbox("Which POKéMON's nickname should\n"
				"I critique?$")
		special (ChoosePartyMon)
		waitstate
		if (var(VAR_0x8004) == 255) {
			goto(TrickHouseRestroom_EventScript_Renamer_End)
		}
		specialvar(VAR_RESULT, ScriptGetPartyMonSpecies)
		special(BufferMonNickname)
		msgbox( "Hmmm… {STR_VAR_1}, is it? That is\n"
				"quite a fine name you bestowed.\p"
				"But! What say you, if I were to\n"
				"suggest a slightly better name?$", MSGBOX_YESNO)
		if (var(VAR_RESULT) == YES) {
			msgbox( "Ah, good. Then, what shall the new\n"
					"nickname be?$")
			call (Common_EventScript_NameReceivedPokemon)
			specialvar(VAR_RESULT, TryPutNameRaterShowOnTheAir)//TV_CheckIfNicknameChanged)
			special(BufferMonNickname)
			if (var(VAR_RESULT) == TRUE) {
				msgbox ("Done! From now on, this POKéMON\n"
						"shall be known as {STR_VAR_1}!\p"
						"It is a better name than before!\n"
						"How fortunate for you!$")
				release
				end
			} else {
				msgbox ("Done! From now on, this POKéMON\n"
						"shall be known as {STR_VAR_1}!\p"
						"It looks no different from before,\n"
						"and yet, this is vastly superior!\p"
						"How fortunate for you!$")
				release
				end
			}
		} else {
			goto(TrickHouseRestroom_EventScript_Renamer_End)
		}
	}
	goto(TrickHouseRestroom_EventScript_Renamer_End)
}
script TrickHouseRestroom_EventScript_Renamer_End {
	msgbox("Very well! Good luck tonight!$")
	release
}

// ----------------------------------------------------
// Kecleon & Secret Passage

raw `

TrickHouseRestroom_EventScript_Kecleon::
	lock
	faceplayer
	checkitem ITEM_DEVON_SCOPE
	goto_if_eq VAR_RESULT, FALSE, TrickHouseRestroom_EventScript_AskUseDevonScope
	msgbox TrickHouseRestroom_Text_SomethingUnseeable, MSGBOX_DEFAULT
	release
	end

TrickHouseRestroom_EventScript_AskUseDevonScope::
	msgbox TrickHouseRestroom_Text_UnseeableUseDevonScope, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, YES, TrickHouseRestroom_EventScript_UseDevonScope
	release
	end

TrickHouseRestroom_EventScript_UseDevonScope::
	msgbox TrickHouseRestroom_Text_UsedDevonScopePokemonFled, MSGBOX_DEFAULT
	closemessage
	applymovement VAR_LAST_TALKED, Movement_KecleonAppears
	waitmovement 0
	waitse
	playmoncry SPECIES_KECLEON, CRY_MODE_ENCOUNTER
	delay 40
	waitmoncry
	applymovement VAR_LAST_TALKED, TrickHouseRestroom_Movement_KecleonFlee
	waitmovement 0
	removeobject VAR_LAST_TALKED
	setflag FLAG_HIDE_KECLEON_RESTROOM
	release
	end

TrickHouseRestroom_EventScript_SecretPassage::
	msgbox TrickHouseRestroom_Text_TheresASecretPassage, MSGBOX_DEFAULT
	msgbox TrickHouseRestroom_Text_WantToGoThrough, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, YES, TrickHouseRestroom_EventScript_SecretPassageWarp
	release
	end
	
TrickHouseRestroom_EventScript_SecretPassageWarp::
	msgbox TrickHouseRestroom_Text_WhoWouldnt, MSGBOX_DEFAULT
	closemessage
	setwarp WARPTYPE_STANDARD, MAP_TRICK_HOUSE_END_OLD, 0
	dowarp WARPTYPE_STANDARD, DOWARP_DOOR
	waitstate
	release
	end

TrickHouseRestroom_Movement_KecleonFlee:
	walk_left
	step_end
	
TrickHouseRestroom_Text_SomethingUnseeable:
	.string "Something unseeable is in the way.$"

TrickHouseRestroom_Text_UnseeableUseDevonScope:
	.string "Something unseeable is in the way.\p"
	.string "Want to use the Devon Scope?$"

TrickHouseRestroom_Text_UsedDevonScopePokemonFled:
	.string "{PLAYER} used the Devon Scope.\p"
	.string "An invisible Pokémon became completely\n"
	.string "visible!\p"
	.string "The startled Pokémon fled!$"
	
TrickHouseRestroom_Text_TheresASecretPassage:
	.string "Hey! There's a secret passage hidden\n"
	.string "here!$"
	
TrickHouseRestroom_Text_WantToGoThrough:
	.string "Do you want to go through?$"
	
TrickHouseRestroom_Text_WhoWouldnt:
	.string "Who wouldn't?$"

`

