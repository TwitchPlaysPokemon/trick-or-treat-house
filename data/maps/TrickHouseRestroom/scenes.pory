// Post-Fortree

script TrickHouseRestroom_OnLoad_Friends_PostFortree {
	setvar(VAR_FRIEND_GROUP_STATE, 11)
	setvar(VAR_WALLY_STATE, 2)
	setobjectxyperm(LID_MAY, 9, 5)  setobjectmovementtype(LID_MAY, MOVEMENT_TYPE_LOOK_AROUND)
}
script TrickHouseRestroom_EventScript_VisitorWally_PostFortree {
	msgbox ("Wait, did I miss ANOTHER trick-or-\n"
			"treating trip?!\p"
			"{JOEY} and {IRENE} distracted me with\n"
			"their fighting!$", MSGBOX_NPC)
}
script TrickHouseRestroom_EventScript_VisitorMay_PostFortree {
	msgbox ("I think I need several minutes to\n"
			"recover from Foretree still…!\p"
			"Can you imagine being that high up\n"
			"ALL THE TIME?!$", MSGBOX_NPC)
}


// --------------------------------------------------------
// AJ Arrives

script TrickHouseRestroom_OnLoad_Friends_AJArrives {
	setvar(VAR_FRIEND_GROUP_STATE, 10)
	setvar(VAR_WALLY_STATE, 103)
	setobjectxyperm(LID_JOEY,9, 5)  setobjectmovementtype(LID_JOEY, MOVEMENT_TYPE_FACE_DOWN)
	setobjectxyperm(LID_AJ,  9, 6)  setobjectmovementtype(LID_AJ, MOVEMENT_TYPE_FACE_UP)
	return
}

script TrickHouseRestroom_EventScript_JoeyAJIntro {
	lock
	speakername(NULL)
	msgbox("{JOEY} and his boyfriend are really\n"
			"close, mumbling to each other,\l"
			"smiling, and giving gentle kisses.$")
	applymovement(LID_JOEY, Common_Movement_FacePlayer)
	applymovement(LID_AJ, Common_Movement_FacePlayer)
	waitmovement(LID_JOEY)
	waitmovement(LID_AJ)
	applymovement(LID_JOEY, Common_Movement_ExclamationMark)
	applymovement(LID_AJ, Common_Movement_ExclamationMark)
	playse(SE_PIN)
	waitmovement(LID_JOEY)
	speakername_common(JOEY)
	msgbox("{PLAYER}! I didn't see you there!\n"
			"Uh, have I introduced you to AJ yet?$")
	setflag(FLAG_TEMP_1)
	release
}
script TrickHouseRestroom_EventScript_VisitorJoey_AJArrives {
	goto_if_unset(FLAG_TEMP_1, TrickHouseRestroom_EventScript_JoeyAJIntro)
	checkplayergender
	if (var(VAR_RESULT) == GENDER_N) {
		msgbox( "Uh, I went and pointed the door at\n"
				"New Bark for a bit and picked him up.\p"
				"If you and {FAIRY} are here together,\n"
				"why can't we as well?$", MSGBOX_NPC)
	} else {
		msgbox( "Uh, I went and pointed the door at\n"
				"New Bark for a bit and picked him up.\p"
				"If {FAIRY} and {ALEX} are here together,\n"
				"why can't we be together too?$", MSGBOX_NPC)
	}
}
script TrickHouseRestroom_EventScript_VisitorAJ_AJArrives {
	goto_if_unset(FLAG_TEMP_1, TrickHouseRestroom_EventScript_JoeyAJIntro)
	poryswitch(TPP_MODE) {
		1 {
			msgbox( "Uh, hey…\n"
					"Sorry if I'm causing any trouble…\p"
					"I'm AJ, by the way.\n"
					"Former Johto and Kanto Champion…\p"
					"…{PAUSE 30} …{PAUSE 30} …{PAUSE 30} I hear them around you…{PAUSE 30}\n"
					"… … The Unown…{PAUSE 60} The Voices…{PAUSE 60} …\p"
					"They're a lot quieter and calmer now…{PAUSE 30}\n"
					"Compared to when they were with me… …$", MSGBOX_NPC)
		}
		_ {
			msgbox( "Uh, hey…\n"
					"Sorry if I'm causing any trouble…\p"
					"I'm AJ, by the way.\n"
					"Former Johto and Kanto Champion…\p"
					"… … … Sorry… I'm not the best at\n"
					"talking to people…$", MSGBOX_NPC)
		}
	}
}
script TrickHouseRestroom_EventScript_VisitorWally_AJArrives {
	if (var(VAR_FOLLOWER_IDENTITY) == FOLLOWER_ID_IRENE) {
		// Irene only follows Alex, so player is Alex here
		msgbox ("You two, explain this whole ‘romance’\n"
				"thing to me. I just don't get it.\p"
				"Who would want to look so silly all\n"
				"the time? What's the big deal?\p"
				"Huh? “Ace”? What about him? What does\n"
				"{JOEY}'s Rattata have to do with me?$", MSGBOX_NPC)
	} else {
		msgbox ("Ugh. They've been over there for like\n"
				"an hour now, it feels like.\p"
				"Someone needs to explain romance to me\n"
				"because I just don't get it.$", MSGBOX_NPC)
	}
}

// ----------------------------------------------------
// Pre-Mossdeep

script TrickHouseRestroom_OnLoad_Friends_PreMossdeep {
	setvar(VAR_FRIEND_GROUP_STATE, 3)
	setvar(VAR_WALLY_STATE, 105)
	setobjectxyperm(LID_JOEY,   11, 4)  setobjectmovementtype(LID_JOEY, MOVEMENT_TYPE_FACE_DOWN)
	setobjectxyperm(LID_AJ,     12, 4)  setobjectmovementtype(LID_AJ, MOVEMENT_TYPE_FACE_DOWN_AND_LEFT)
	setobjectxyperm(LID_IRENE,  13, 5)  setobjectmovementtype(LID_IRENE, MOVEMENT_TYPE_FACE_DOWN_AND_LEFT)
	setobjectxyperm(LID_JAMES,   9, 5)  setobjectmovementtype(LID_JAMES, MOVEMENT_TYPE_FACE_RIGHT)
	setobjectxyperm(LID_BRENDAN,10, 6)  setobjectmovementtype(LID_BRENDAN, MOVEMENT_TYPE_FACE_UP_AND_RIGHT)
	setobjectxyperm(LID_MAY,    10, 4)  setobjectmovementtype(LID_MAY, MOVEMENT_TYPE_FACE_DOWN_AND_RIGHT)
	setobjectxyperm(LID_ALEX,   13, 6)  setobjectmovementtype(LID_ALEX, MOVEMENT_TYPE_FACE_LEFT)
	setobjectxyperm(LID_WALLY,  12, 7)  setobjectmovementtype(LID_WALLY, MOVEMENT_TYPE_FACE_UP_LEFT_AND_RIGHT)
	setobjectxyperm(LID_LETTER, 11, 5)  setobjectmovementtype(LID_LETTER, MOVEMENT_TYPE_FACE_UP)
	return
}
script TrickHouseRestroom_EventScript_VisitorJoey_PreMossdeep {
	msgbox( "Alright, guys! Not all at once!\p"
			"Working out the rune coordinates is hard\n"
			"enough without everyone yelling at me!$", MSGBOX_SIGN)
}
script TrickHouseRestroom_EventScript_VisitorIrene_PreMossdeep {
	msgbox( "{JOEY}! It's my turn! You got to point\n"
			"the door where you wanted to go!\p"
			"Mossdeep seems like the best place to\n"
			"go next!$", MSGBOX_SIGN)
}
script TrickHouseRestroom_EventScript_VisitorJames_PreMossdeep {
	msgbox( "I've always wanted to visit Pacifidlog.\n"
			"A floating city sounds sweet as heck!$", MSGBOX_SIGN)
}
script TrickHouseRestroom_EventScript_VisitorBrendan_PreMossdeep {
	msgbox( "I remember Dad taking me to Saffron City\n"
			"when I was little! That place is huge!\p"
			"We could easily hit dozens of apartments!$", MSGBOX_SIGN)
}
script TrickHouseRestroom_EventScript_VisitorMay_PreMossdeep {
	msgbox( "I think Mossdeep is pretty big!\n"
			"Dozens of houses to hit there!\p"
			"And I think they've got a rocket launch\n"
			"planned for this evening as well!$", MSGBOX_SIGN)
}
script TrickHouseRestroom_EventScript_VisitorAlex_PreMossdeep {
	msgbox( "There's a place I visited on holiday\n"
			"a couple years back! Alto Mare?\p"
			"It's a giant city that could easily\n"
			"have a hundred houses to hit up!$", MSGBOX_SIGN)
}
script TrickHouseRestroom_EventScript_VisitorAJ_PreMossdeep {
	msgbox( "Goldenrod has loads of houses!\p"
			"And Bill gives out huge slabs of\n"
			"some of the best chocolate!$", MSGBOX_SIGN)
}
script TrickHouseRestroom_EventScript_VisitorWally_PreMossdeep {
	msgbox( "This is chaos! No one can decide where\n"
			"to trick-or-treat next.\p"
			"Joey figures we've got one more chance\n"
			"to do this tonight, before it gets too\l"
			"late to Trick-or-Treat.$", MSGBOX_NPC)
}


