raw `
#define VAR_BREEDER_STATE        VAR_TEMP_1
#define VAR_BIRCH_STATE          VAR_TEMP_2
#define VAR_WALLY_STATE          VAR_TEMP_3
#define VAR_FRIEND_GROUP_STATE   VAR_TEMP_B
#define LID_LETTER               15
`


// ----------------------------------------------------
// Breeder 

raw `
#define LID_BREEDER 10
#define LID_BALL_1  11
#define LID_BALL_2  12
#define LID_PIKACHU 13
`

script TrickHouseRestroom_OnLoad_Breeder {
	callnative (GetNumPuzzlesCompleted)
	copyvar(VAR_0x800B, VAR_RESULT)
	if (var(VAR_0x800B) < 3) {
		// The breeder hangs out with a few pokeballs before the first few puzzles are done
		setvar(VAR_BREEDER_STATE, 0)
		setobjectxyperm(LID_BREEDER, 9, 9)
		setobjectmovementtype(LID_BREEDER, MOVEMENT_TYPE_LOOK_AROUND)
		setobjectxyperm(LID_BALL_1, 10, 9)
		setobjectxyperm(LID_BALL_2, 10, 8)
		return
	}
	if (var(VAR_0x800B) > 7 && var(VAR_0x800B) < 10) {
		setvar(VAR_BREEDER_STATE, 1)
		setobjectxyperm(LID_BREEDER, 12, 4)
		setobjectmovementtype(LID_BREEDER, MOVEMENT_TYPE_FACE_LEFT)
		return
	}
	if (var(VAR_0x800B) > 14 && var(VAR_0x800B) < 18) {
		setvar(VAR_BREEDER_STATE, 2)
		setobjectxyperm(LID_BREEDER, 7, 4)
		setobjectmovementtype(LID_BREEDER, MOVEMENT_TYPE_LOOK_AROUND)
		return
	}
	if (var(VAR_0x800B) > 22 && var(VAR_0x800B) < 28) {
		setvar(VAR_BREEDER_STATE, 3)
		setobjectxyperm(LID_PIKACHU, 1, 10)
		setobjectxyperm(LID_BREEDER, 2, 10)
		setobjectmovementtype(LID_BREEDER, MOVEMENT_TYPE_LOOK_AROUND)
		return
	}
	if (var(VAR_0x800B) > 34) {
		setvar(VAR_BREEDER_STATE, 10)
		setobjectxyperm(LID_BREEDER, 7, 4)
		setobjectmovementtype(LID_BREEDER, MOVEMENT_TYPE_FACE_DOWN)
		setobjectxyperm(LID_LETTER, 7, 5)
		setobjectmovementtype(LID_LETTER, MOVEMENT_TYPE_FACE_UP)
		return
	}
	return
}
script TrickHouseRestroom_EventScript_Breeder {
	switch (var(VAR_BREEDER_STATE)) {
		default:
		case 0:
			msgbox ("Hey, how are my buddies treating you?\n"
					"Are you treating them well too?\p"
					"They're rescue {POKEMON}, so they might\n"
					"be a bit timid at first. But they'll\l"
					"warm up to you in no time!$", MSGBOX_NPC)
		case 10:
			msgbox ("Hey. The night's coming to a close.\n"
					"So I'm getting adoption papers ready.\p"
					"How are my buddies doing for you?\n"
					"They seem pretty happy.$", MSGBOX_NPC)
	}
}
script TrickHouseRestroom_EventScript_BreederBall {
	msgbox ("One of the {POKEMON} you didn't choose.\n"
			"Hopefully someone adopts it.$", MSGBOX_SIGN)
}
script TrickHouseRestroom_EventScript_BreederChu {
	lock
	faceplayer
	playmoncry (SPECIES_PIKACHU, 0)
	msgbox ("Pikachu: Chuu!$")
	waitmoncry
	waitmessage
	release
}

raw `
#undef LID_BREEDER
#undef LID_BALL_1
#undef LID_BALL_2
#undef LID_PIKACHU
`

// ----------------------------------------------------
// Birch
raw `
#define LID_BIRCH 4
`

script TrickHouseRestroom_OnLoad_Birch {
	callnative (GetNumPuzzlesCompleted)
	copyvar(VAR_0x800B, VAR_RESULT)
	if (var(VAR_0x800B) > 8 && var(VAR_0x800B) < 12) {
		// Prof Birch is sitting here
		setobjectxyperm(LID_BIRCH, 9, 5)
	}
	return
}
script TrickHouseRestroom_EventScript_VisitorBirch {
	speakername("Prof Birch")
	msgbox ("Hey, {PLAYER}!\n"
			"How's your night been so far?\p"
			"The Trick Master has really outdone\n"
			"himself this year, hasn't he?\p"
			"This place is really becoming the\n"
			"Halloween Hangout House of Hoenn!$", MSGBOX_NPC)
}

raw `
#undef LID_BIRCH
`
// ----------------------------------------------------
// Wally
raw `
#define LID_WALLY 8
`

script TrickHouseEntrance_OnLoad_Wally {
	if (var(VAR_CURRENT_PUZZLE) > 7) { // 32
		// Hide Wally from the Entrance
		setflag(FLAG_TEMP_10)
	}
	return
}
script TrickHouseRestroom_OnLoad_Wally {
	if (var(VAR_CURRENT_PUZZLE) <= 7) {
		return // Wally is in the entrance
	}
	callnative(CheckCurrentPuzzleMap)
	switch (var(VAR_RESULT)) {
		// case MAP_PUZZLE_TRAINER_HILL4: //TODO
		case MAP_PUZZLE_SAFARI_IMPOSTERS:
		case MAP_PUZZLE_META_PUZZLE:
		case MAP_PUZZLE_CREDITS:
			return 
	}
	// Position to default location
	setobjectxyperm(LID_WALLY, 2, 6)
	if (var(VAR_CURRENT_PUZZLE) > 7 && var(VAR_CURRENT_PUZZLE) < 10) {
		setvar(VAR_WALLY_STATE, 1)
	}
	// callnative(CheckNextPuzzleMap)
	// switch (var(VAR_RESULT)) {
	// }
	// callnative(CheckCurrentPuzzleMap)
	// switch (var(VAR_RESULT)) {
	// }
	
	// Note: Friend state may override
	return
}

script TrickHouseRestroom_EventScript_VisitorWally {
	speakername_common(WALLY)
	switch (var(VAR_WALLY_STATE)) {
		default:
			goto(TrickHouseEntrance_EventScript_Wally)
		case 1:
			msgbox ("I heard you guys somehow visited\n"
					"Petalburg without me?\p"
					"But how? I was sitting in the entrance\n"
					"the whole time! I didn't see you leave!$", MSGBOX_NPC)
		case 101:
			msgbox ("Man, they're really going at it over\n"
					"there, aren't they?$", MSGBOX_NPC)
		case 102:
			msgbox ("Did you see where {LINK} went?\p"
					"I think he snuck out while I was\n"
					"distracted by their arguing.$", MSGBOX_NPC)
		case 103:
			msgbox ("Ugh. They've been over there for like\n"
					"an hour now, it feels like.\p"
					"Someone needs to explain romance to me\n"
					"because I just don't get it.$", MSGBOX_NPC)
		
	}
}

// ----------------------------------------------------
// Other Friends
raw `
#define LID_JAMES  7
#define LID_JOEY   5
#define LID_IRENE  6
#define LID_AJ     14
`

script TrickHouseRestroom_OnLoad_Friends {
	callnative(CheckNextPuzzleMap)
	switch (var(VAR_RESULT)) {
		case MAP_TRICK_TREAT_PETALBURG_CITY:
			setvar(VAR_FRIEND_GROUP_STATE, 1)
			setobjectxyperm(LID_JOEY,   9, 5)  setobjectmovementtype(LID_JOEY, MOVEMENT_TYPE_FACE_RIGHT)
			setobjectxyperm(LID_JAMES, 10, 4)  setobjectmovementtype(LID_JAMES, MOVEMENT_TYPE_FACE_DOWN)
			setobjectxyperm(LID_IRENE, 10, 6)  setobjectmovementtype(LID_IRENE, MOVEMENT_TYPE_FACE_UP)
			setobjectxyperm(LID_LETTER,10, 5)  setobjectmovementtype(LID_LETTER, MOVEMENT_TYPE_FACE_LEFT)
			return
		case MAP_TRICK_TREAT_FORTREE_CITY:
			setvar(VAR_FRIEND_GROUP_STATE, 2)
			setvar(VAR_WALLY_STATE, 101)
			setobjectxyperm(LID_JOEY,  10, 7)  setobjectmovementtype(LID_JOEY, MOVEMENT_TYPE_FACE_DOWN)
			setobjectxyperm(LID_IRENE, 10, 9)  setobjectmovementtype(LID_IRENE, MOVEMENT_TYPE_FACE_UP)
			setobjectxyperm(LID_LETTER,10, 8)  setobjectmovementtype(LID_LETTER, MOVEMENT_TYPE_FACE_DOWN)
			setobjectxyperm(LID_JAMES,  1, 6)  setobjectmovementtype(LID_JAMES, MOVEMENT_TYPE_FACE_DOWN_AND_RIGHT)
			return
		case MAP_TRICK_TREAT_MOSSDEEP_CITY:
	}
	
	callnative(CheckCurrentPuzzleMap)
	switch (var(VAR_RESULT)) {
		case MAP_TRICK_TREAT_FORTREE_CITY:
			setvar(VAR_FRIEND_GROUP_STATE, 2)
			setvar(VAR_WALLY_STATE, 102)
			setobjectxyperm(LID_JOEY,  10, 7)  setobjectmovementtype(LID_JOEY, MOVEMENT_TYPE_FACE_DOWN)
			setobjectxyperm(LID_IRENE, 10, 9)  setobjectmovementtype(LID_IRENE, MOVEMENT_TYPE_FACE_UP)
			setobjectxyperm(LID_LETTER,10, 8)  setobjectmovementtype(LID_LETTER, MOVEMENT_TYPE_FACE_DOWN)
			return
		case MAP_PUZZLE_HIDDEN_MAZE:
		case MAP_PUZZLE_LOSS_FLOOR1:
		case MAP_PUZZLE_TRICK_HOUSE_SLIP_SLIDING:
			setvar(VAR_FRIEND_GROUP_STATE, 10)
			setvar(VAR_WALLY_STATE, 103)
			setobjectxyperm(LID_JOEY,9, 5)  setobjectmovementtype(LID_JOEY, MOVEMENT_TYPE_FACE_DOWN)
			setobjectxyperm(LID_AJ,  9, 6)  setobjectmovementtype(LID_AJ, MOVEMENT_TYPE_FACE_UP)
			return
	}
	
	
	// Finally, ensure that friends who are currently followers do not show up here
	switch (var(VAR_FOLLOWER_IDENTITY)) {
		case FOLLOWER_ID_BRENDAN: nop //setobjectxyperm(LID_BRENDAN, 100, 100)
		case FOLLOWER_ID_MAY:   nop //setobjectxyperm(LID_MAY, 100, 100)
		case FOLLOWER_ID_ALEX:  nop //setobjectxyperm(LID_ALEX, 100, 100)
		case FOLLOWER_ID_JOEY:  setobjectxyperm(LID_JOEY, 100, 100)
		case FOLLOWER_ID_JAMES: setobjectxyperm(LID_JAMES, 100, 100)
		case FOLLOWER_ID_IRENE: setobjectxyperm(LID_IRENE, 100, 100)
		case FOLLOWER_ID_WALLY: setobjectxyperm(LID_WALLY, 100, 100)
	}
	// And that friends who are the player do not show up here
	checkplayergender
	switch (var(VAR_RESULT)) {
		case GENDER_M: nop //setobjectxyperm(LID_BRENDAN, 100, 100)
		case GENDER_F: nop //setobjectxyperm(LID_MAY, 100, 100)
		case GENDER_N: nop //setobjectxyperm(LID_ALEX, 100, 100)
	}
}

script TrickHouseRestroom_EventScript_VisitorJoey {
	speakername_common(JOEY)
	switch(var(VAR_FRIEND_GROUP_STATE)) {
		case 1:
			msgbox( "But then there are these runes\n"
					"down the side of the door.\p"
					"I've seen them before in the\n"
					"Ruins of Alph back in Johto.\p"
					"They could well be spelling out…$", MSGBOX_SIGN)
		case 2: goto(TrickHouseRestroom_EventScript_JoeyIreneFight)
		case 10:
			if (!flag(FLAG_TEMP_1)) {
				goto(TrickHouseRestroom_EventScript_JoeyAJIntro)
			} else {
				checkplayergender
				if (var(VAR_RESULT) == GENDER_N) {
			msgbox( "Uh, I went and pointed the door at\n"
					"New Bark for a bit and picked him up.\p"
					"If you and {FAIRY} are here together,\n"
					"why can't we as well?$", MSGBOX_NPC)
				} else {
			msgbox( "Uh, I went and pointed the door at\n"
					"New Bark for a bit and picked him up.\p"
					"If {FAIRY} and {ALEX} are here together,\n"
					"why can't we be together too?$", MSGBOX_NPC)
				}
			}
			
	}
}

script TrickHouseRestroom_EventScript_VisitorIrene {
	speakername_common(IRENE)
	switch(var(VAR_FRIEND_GROUP_STATE)) {
		case 1:
			msgbox( "But did you see the strange symbol\n"
					"adorning the bottom?\p"
					"I swear I've seen some of those back\n"
					"home in Dragonspiral Tower…$", MSGBOX_SIGN)
		case 2: goto(TrickHouseRestroom_EventScript_JoeyIreneFight)
	}
}

script TrickHouseRestroom_EventScript_VisitorJames {
	speakername_common(JAMES)
	switch(var(VAR_FRIEND_GROUP_STATE)) {
		case 1:
			msgbox("This could be the best idea\n"
					"you've ever had, {JOEY}.\p"
					"Think of all the places we can go\n"
					"trick or treating at…$", MSGBOX_SIGN)
		case 2:
			checkplayergender
			if (var(VAR_RESULT) == GENDER_N) {
			msgbox ("Come to witness the Great Throwdown?\p"
					"{PLAYER}, can you like… go calm your\n"
					"girlfriend down or something?\p"
					"Seriously, I'm about to sneak out\n"
					"and use the door while they're arguing.$", MSGBOX_NPC)
			} else {
			msgbox ("Come to witness the Great Throwdown?\p"
					"I don't understand why they don't\n"
					"just take turns.\p"
					"Seriously, I'm about to sneak out\n"
					"and use the door while they're arguing.$", MSGBOX_NPC)
				
			}
	}
}

script TrickHouseRestroom_EventScript_VisitorAJ {
	speakername("AJ Dinnow") //AJDNNW
	switch(var(VAR_FRIEND_GROUP_STATE)) {
		case 10:
			if (!flag(FLAG_TEMP_1)) {
				goto(TrickHouseRestroom_EventScript_JoeyAJIntro)
			} else {
				poryswitch(TPP_MODE) {
					1 {
			msgbox( "Uh, hey…\n"
					"Sorry if I'm causing any trouble…\p"
					"I'm AJ, by the way.\n"
					"Former Johto and Kanto Champion…\p"
					"…{PAUSE 30} …{PAUSE 30} …{PAUSE 30} I hear them around you…{PAUSE 30}\n"
					"… … The Unown…{PAUSE 60} The Voices…{PAUSE 60} …\p"
					"They're a lot quieter and calmer now…{PAUSE 30}\n"
					"Compared to when they were with me… …$", MSGBOX_NPC)
					}
					_ {
			msgbox( "Uh, hey…\n"
					"Sorry if I'm causing any trouble…\p"
					"I'm AJ, by the way.\n"
					"Former Johto and Kanto Champion…\p"
					"… … … Sorry… I'm not the best at\n"
					"talking to people…$", MSGBOX_NPC)
					}
				}
			}
			
	}
}


script TrickHouseRestroom_EventScript_JoeyIreneFight {
	lockall
	playbgm(MUS_DP_ENCOUNTER_ELITE_FOUR, FALSE)
	delay(15)
	applymovement(LID_JOEY, TrickHouseRestroom_Movement_JoeyIreneFight_1)
	playse(SE_LEDGE)  delay(16)
	playse(SE_LEDGE)  delay(16)
	waitmovement(LID_JOEY)
	speakername_common(JOEY)
	msgbox ("We don't know yet that the door can\n"
			"go that far!\p"
			"It's already been to Johto!$")
	
	applymovement(LID_IRENE, TrickHouseRestroom_Movement_JoeyIreneFight_2)
	playse(SE_LEDGE)  delay(16)
	playse(SE_LEDGE)  delay(16)
	waitmovement(LID_IRENE)
	speakername_common(IRENE)
	msgbox ("Did you not see the Jungle Maze!?\n"
			"I'm pretty sure that was in New Guinea!\p"
			"And the stealth maze definitely was a\n"
			"Team Galatic building!$")
	
	speakername_common(JOEY)
	msgbox ("And neither of those places is Unova!\n"
			"They're not even outside this timezone!\p"
			"Isn't it like 3am in Unova right now?!$")
	
	speakername_common(IRENE)
	msgbox ("You just want an excuse to go\n"
			"pick up your boyfriend!$")
	
	speakername_common(JOEY)
	msgbox ("So what? You can have your boifriend,\n"
			"but I can't have my boyfriend?!$")
			// spelling of "boifriend" is deliberate
	
	checkplayergender
	if (var(VAR_RESULT) == GENDER_N) {
		if (var(VAR_LAST_TALKED) == LID_JOEY) {
			faceplayer
		}
		msgbox("Uh, no offense, {PLAYER}.")
		applymovement(LID_JOEY, Common_Movement_FaceDown)
		waitmovement(LID_JOEY)
	}
	fadedefaultbgm
	releaseall
}
movement TrickHouseRestroom_Movement_JoeyIreneFight_1 {
	jump_in_place_down * 2
}
movement TrickHouseRestroom_Movement_JoeyIreneFight_2 {
	jump_in_place_up * 2
}

script TrickHouseRestroom_EventScript_JoeyAJIntro {
	lock
	speakername(NULL)
	msgbox("{JOEY} and his boyfriend are really\n"
			"close, mumbling to each other,\l"
			"smiling, and giving gentle kisses.$")
	applymovement(LID_JOEY, Common_Movement_FacePlayer)
	applymovement(LID_AJ, Common_Movement_FacePlayer)
	waitmovement(LID_JOEY)
	waitmovement(LID_AJ)
	applymovement(LID_JOEY, Common_Movement_ExclamationMark)
	applymovement(LID_AJ, Common_Movement_ExclamationMark)
	playse(SE_PIN)
	waitmovement(LID_JOEY)
	speakername_common(JOEY)
	msgbox("{PLAYER}! I didn't see you there!\n"
			"Uh, have I introduced you to AJ yet?$")
	setflag(FLAG_TEMP_1)
	release
}

