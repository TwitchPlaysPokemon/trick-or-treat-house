raw `
#define VAR_BREEDER_STATE        VAR_TEMP_1
#define VAR_BIRCH_STATE          VAR_TEMP_2
#define VAR_WALLY_STATE          VAR_TEMP_3
#define VAR_FRIEND_GROUP_STATE   VAR_TEMP_B
#define LID_LETTER               15
`


// ----------------------------------------------------
// Breeder 

raw `
#define LID_BREEDER 10
#define LID_BALL_1  11
#define LID_BALL_2  12
#define LID_PIKACHU 13
`

script TrickHouseRestroom_OnLoad_Breeder {
	callnative (GetNumPuzzlesCompleted)
	copyvar(VAR_0x800B, VAR_RESULT)
	if (var(VAR_0x800B) < 3) {
		// The breeder hangs out with a few pokeballs before the first few puzzles are done
		setvar(VAR_BREEDER_STATE, 0)
		setobjectxyperm(LID_BREEDER, 9, 9)
		setobjectmovementtype(LID_BREEDER, MOVEMENT_TYPE_LOOK_AROUND)
		setobjectxyperm(LID_BALL_1, 10, 9)
		setobjectxyperm(LID_BALL_2, 10, 8)
		return
	}
	if (var(VAR_0x800B) > 7 && var(VAR_0x800B) < 10) {
		setvar(VAR_BREEDER_STATE, 1)
		setobjectxyperm(LID_BREEDER, 12, 4)
		setobjectmovementtype(LID_BREEDER, MOVEMENT_TYPE_FACE_LEFT)
		return
	}
	if (var(VAR_0x800B) > 14 && var(VAR_0x800B) < 18) {
		setvar(VAR_BREEDER_STATE, 2)
		setobjectxyperm(LID_BREEDER, 9, 2)
		setobjectmovementtype(LID_BREEDER, MOVEMENT_TYPE_LOOK_AROUND)
		return
	}
	if (var(VAR_0x800B) > 22 && var(VAR_0x800B) < 28) {
		setvar(VAR_BREEDER_STATE, 3)
		setobjectxyperm(LID_PIKACHU, 1, 10)
		setobjectxyperm(LID_BREEDER, 2, 10)
		setobjectmovementtype(LID_BREEDER, MOVEMENT_TYPE_LOOK_AROUND)
		return
	}
	if (var(VAR_0x800B) > 34) {
		setvar(VAR_BREEDER_STATE, 10)
		setobjectxyperm(LID_BREEDER, 1, 6)
		setobjectmovementtype(LID_BREEDER, MOVEMENT_TYPE_FACE_DOWN)
		setobjectxyperm(LID_LETTER, 1, 7)
		setobjectmovementtype(LID_LETTER, MOVEMENT_TYPE_FACE_UP)
		return
	}
	return
}
script TrickHouseRestroom_EventScript_Breeder {
	switch (var(VAR_BREEDER_STATE)) {
		default:
		case 0:
			msgbox ("Hey, how are my buddies treating you?\n"
					"Are you treating them well too?\p"
					"They're rescue {POKEMON}, so they might\n"
					"be a bit timid at first. But they'll\l"
					"warm up to you in no time!$", MSGBOX_NPC)
		case 10:
			msgbox ("Hey. The night's coming to a close.\n"
					"So I'm getting adoption papers ready.\p"
					"How are my buddies doing for you?\n"
					"They seem pretty happy.$", MSGBOX_NPC)
	}
}
script TrickHouseRestroom_EventScript_BreederBall {
	msgbox ("One of the {POKEMON} you didn't choose.\n"
			"Hopefully someone adopts it.$", MSGBOX_SIGN)
}
script TrickHouseRestroom_EventScript_BreederChu {
	lock
	faceplayer
	playmoncry (SPECIES_PIKACHU, 0)
	msgbox ("Pikachu: Chuu!$")
	waitmoncry
	waitmessage
	release
}

raw `
#undef LID_BREEDER
#undef LID_BALL_1
#undef LID_BALL_2
#undef LID_PIKACHU
`

// ----------------------------------------------------
// Birch
raw `
#define LID_BIRCH 4
`

script TrickHouseRestroom_OnLoad_Birch {
	callnative (GetNumPuzzlesCompleted)
	copyvar(VAR_0x800B, VAR_RESULT)
	if (var(VAR_0x800B) > 8 && var(VAR_0x800B) < 12) {
		// Prof Birch is sitting here
		setobjectxyperm(LID_BIRCH, 9, 5)
	}
	return
}
script TrickHouseRestroom_EventScript_VisitorBirch {
	speakername("Prof Birch")
	msgbox ("Hey, {PLAYER}!\n"
			"How's your night been so far?\p"
			"The Trick Master has really outdone\n"
			"himself this year, hasn't he?\p"
			"This place is really becoming the\n"
			"Halloween Hangout House of Hoenn!$", MSGBOX_NPC)
}

raw `
#undef LID_BIRCH
`
// ----------------------------------------------------
// Friend on-loads
raw `
#define LID_WALLY   8
#define LID_JAMES   7
#define LID_JOEY    5
#define LID_IRENE   6
#define LID_AJ      14
#define LID_BRENDAN 19
#define LID_MAY     20
#define LID_ALEX    18
`

script TrickHouseEntrance_OnLoad_Wally {
	if (var(VAR_CURRENT_PUZZLE) > 7) { // 32
		// Hide Wally from the Entrance
		setflag(FLAG_TEMP_10)
	}
	return
}
script TrickHouseRestroom_OnLoad_Wally {
	if (var(VAR_CURRENT_PUZZLE) <= 7) {
		return // Wally is in the entrance
	}
	callnative(CheckCurrentPuzzleMap)
	switch (var(VAR_RESULT)) {
		// case MAP_PUZZLE_TRAINER_HILL4: //TODO
		case MAP_PUZZLE_SAFARI_IMPOSTERS:
		case MAP_PUZZLE_META_PUZZLE:
		case MAP_PUZZLE_CREDITS:
			return 
	}
	// Position to default location
	setobjectxyperm(LID_WALLY, 2, 6)
	if (var(VAR_CURRENT_PUZZLE) > ID_TRICK_TREAT_PETALBURG && var(VAR_CURRENT_PUZZLE) < ID_TRICK_TREAT_PETALBURG+3) {
		setvar(VAR_WALLY_STATE, 1)
	}
	// Note: Friend state may override
	return
}

script TrickHouseRestroom_OnLoad_Friends {
	call(TrickHouseRestroom_OnLoad_Wally) // setup wally first
	
	// callnative(CheckCurrentPuzzleMap)
	goto_if_eq(VAR_CURRENT_PUZZLE, ID_TRICK_TREAT_PETALBURG-1, TrickHouseRestroom_OnLoad_Friends_PlanningPetalburgh)
	goto_if_eq(VAR_CURRENT_PUZZLE, ID_TRICK_TREAT_PETALBURG+0, TrickHouseRestroom_OnLoad_Friends_ParaPetalburgh)
	
	goto_if_eq(VAR_CURRENT_PUZZLE, ID_PUZZLE_LEDGE_MOUNTAIN+1, TrickHouseRestroom_OnLoad_Friends_PostLedges)
	
	goto_if_eq(VAR_CURRENT_PUZZLE, ID_TRICK_TREAT_FORTREE-2, TrickHouseRestroom_OnLoad_Friends_PrePreFortree)
	goto_if_eq(VAR_CURRENT_PUZZLE, ID_TRICK_TREAT_FORTREE-1, TrickHouseRestroom_OnLoad_Friends_PreFortree)
	goto_if_eq(VAR_CURRENT_PUZZLE, ID_TRICK_TREAT_FORTREE+0, TrickHouseRestroom_OnLoad_Friends_ParaFortree)
	goto_if_eq(VAR_CURRENT_PUZZLE, ID_TRICK_TREAT_FORTREE+1, TrickHouseRestroom_OnLoad_Friends_PostFortree)
	goto_if_eq(VAR_CURRENT_PUZZLE, ID_TRICK_TREAT_FORTREE+2, TrickHouseRestroom_OnLoad_Friends_AJArrives)
	goto_if_eq(VAR_CURRENT_PUZZLE, ID_PUZZLE_LOSS_FLOOR1, TrickHouseRestroom_OnLoad_Friends_AJArrives) // Loss puzzle
	// goto_if_eq(VAR_RESULT, MAP_PUZZLE_LOSS_FLOOR1, TrickHouseRestroom_OnLoad_Friends_AJArrives) // Loss puzzle
	
	goto_if_eq(VAR_CURRENT_PUZZLE, ID_TRICK_TREAT_MOSSDEEP-1, TrickHouseRestroom_OnLoad_Friends_PreMossdeep)
	goto_if_eq(VAR_CURRENT_PUZZLE, ID_TRICK_TREAT_MOSSDEEP+0, TrickHouseRestroom_OnLoad_Friends_ParaMossdeep)
	
	
}
script TrickHouseRestroom_OnLoad_CleanupDuplicates {
	// Finally, ensure that friends who are currently followers do not show up here
	switch (var(VAR_FOLLOWER_IDENTITY)) {
		case FOLLOWER_ID_BRENDAN: setobjectxyperm(LID_BRENDAN, 100, 100)
		case FOLLOWER_ID_MAY:     setobjectxyperm(LID_MAY, 100, 100)
		case FOLLOWER_ID_ALEX:    setobjectxyperm(LID_ALEX, 100, 100)
		case FOLLOWER_ID_JOEY:    setobjectxyperm(LID_JOEY, 100, 100)
		case FOLLOWER_ID_JAMES:   setobjectxyperm(LID_JAMES, 100, 100)
		case FOLLOWER_ID_IRENE:   setobjectxyperm(LID_IRENE, 100, 100)
		case FOLLOWER_ID_WALLY:   setobjectxyperm(LID_WALLY, 100, 100)
	}
	// And that friends who are the player do not show up here
	checkplayergender
	switch (var(VAR_RESULT)) {
		case GENDER_M: setobjectxyperm(LID_BRENDAN, 100, 100)
		case GENDER_F: setobjectxyperm(LID_MAY, 100, 100)
		case GENDER_N: setobjectxyperm(LID_ALEX, 100, 100)
	}
}


// ----------------------------------------------------
// Friend entry points

script TrickHouseRestroom_EventScript_VisitorWally {
	speakername_common(WALLY)
	goto_if_eq(VAR_WALLY_STATE, 1, TrickHouseRestroom_EventScript_VisitorWally_PostPetalburgh)
	goto_if_eq(VAR_WALLY_STATE, 2, TrickHouseRestroom_EventScript_VisitorWally_PostFortree)
	goto_if_eq(VAR_WALLY_STATE, 3, TrickHouseRestroom_EventScript_VisitorWally_PostLedges)
	goto_if_eq(VAR_WALLY_STATE, 101, TrickHouseRestroom_EventScript_VisitorWally_PreFortree)
	goto_if_eq(VAR_WALLY_STATE, 102, TrickHouseRestroom_EventScript_VisitorWally_ParaFortree)
	goto_if_eq(VAR_WALLY_STATE, 103, TrickHouseRestroom_EventScript_VisitorWally_AJArrives)
	goto_if_eq(VAR_WALLY_STATE, 105, TrickHouseRestroom_EventScript_VisitorWally_PreMossdeep)
	goto(TrickHouseEntrance_EventScript_Wally)
}
script TrickHouseRestroom_EventScript_VisitorJoey {
	speakername_common(JOEY)
	goto_if_eq(VAR_FRIEND_GROUP_STATE, 1, TrickHouseRestroom_EventScript_VisitorJoey_PlanningPetalburgh)
	goto_if_eq(VAR_FRIEND_GROUP_STATE, 2, TrickHouseRestroom_EventScript_VisitorJoey_FortreeFight)
	goto_if_eq(VAR_FRIEND_GROUP_STATE, 3, TrickHouseRestroom_EventScript_VisitorJoey_PreMossdeep)
	goto_if_eq(VAR_FRIEND_GROUP_STATE, 10, TrickHouseRestroom_EventScript_VisitorJoey_AJArrives)
	goto_if_eq(VAR_FRIEND_GROUP_STATE, 11, TrickHouseRestroom_EventScript_VisitorJoey_PlanningFortree)
	release
}
script TrickHouseRestroom_EventScript_VisitorIrene {
	speakername_common(IRENE)
	goto_if_eq(VAR_FRIEND_GROUP_STATE, 1, TrickHouseRestroom_EventScript_VisitorIrene_PlanningPetalburgh)
	goto_if_eq(VAR_FRIEND_GROUP_STATE, 2, TrickHouseRestroom_EventScript_VisitorIrene_FortreeFight)
	goto_if_eq(VAR_FRIEND_GROUP_STATE, 3, TrickHouseRestroom_EventScript_VisitorIrene_PreMossdeep)
	release
}
script TrickHouseRestroom_EventScript_VisitorJames {
	speakername_common(JAMES)
	goto_if_eq(VAR_FRIEND_GROUP_STATE, 1, TrickHouseRestroom_EventScript_VisitorJames_PlanningPetalburgh)
	goto_if_eq(VAR_FRIEND_GROUP_STATE, 2, TrickHouseRestroom_EventScript_VisitorJames_FortreeFight)
	goto_if_eq(VAR_FRIEND_GROUP_STATE, 3, TrickHouseRestroom_EventScript_VisitorJames_PreMossdeep)
	release
}
script TrickHouseRestroom_EventScript_VisitorBrendan {
	speakername_common(BRENDAN)
	goto_if_eq(VAR_FRIEND_GROUP_STATE, 3, TrickHouseRestroom_EventScript_VisitorBrendan_PreMossdeep)
	goto_if_eq(VAR_FRIEND_GROUP_STATE, 12, TrickHouseRestroom_EventScript_VisitorBrendan_PostLedges)
	release
}
script TrickHouseRestroom_EventScript_VisitorMay {
	speakername_common(MAY)
	goto_if_eq(VAR_FRIEND_GROUP_STATE, 3, TrickHouseRestroom_EventScript_VisitorMay_PreMossdeep)
	goto_if_eq(VAR_FRIEND_GROUP_STATE, 11, TrickHouseRestroom_EventScript_VisitorMay_PostFortree)
	release
}
script TrickHouseRestroom_EventScript_VisitorAlex {
	speakername_common(ALEX)
	goto_if_eq(VAR_FRIEND_GROUP_STATE, 3, TrickHouseRestroom_EventScript_VisitorAlex_PreMossdeep)
	release
}
script TrickHouseRestroom_EventScript_VisitorAJ {
	speakername("AJ Dinnow") //AJDNNW
	goto_if_eq(VAR_FRIEND_GROUP_STATE, 3, TrickHouseRestroom_EventScript_VisitorAJ_PreMossdeep)
	goto_if_eq(VAR_FRIEND_GROUP_STATE, 10, TrickHouseRestroom_EventScript_VisitorAJ_AJArrives)
	release
}
script TrickHouseRestroom_EventScript_Note {
	goto_if_eq(VAR_FRIEND_GROUP_STATE, 1, TrickHouseRestroom_EventScript_Note_PlanningPetalburgh)
	goto_if_eq(VAR_FRIEND_GROUP_STATE, 2, TrickHouseRestroom_EventScript_Note_FortreeFight)
	goto_if_eq(VAR_FRIEND_GROUP_STATE, 3, TrickHouseRestroom_EventScript_Note_PreMossdeep)
	release
}

//=========================================================
// Scenes


// --------------------------------------------------------
// Planning Petalburgh

script TrickHouseRestroom_OnLoad_Friends_PlanningPetalburgh {
	setvar(VAR_FRIEND_GROUP_STATE, 1)
	setobjectxyperm(LID_JOEY,   9, 5)  setobjectmovementtype(LID_JOEY, MOVEMENT_TYPE_FACE_RIGHT)
	setobjectxyperm(LID_JAMES, 10, 4)  setobjectmovementtype(LID_JAMES, MOVEMENT_TYPE_FACE_DOWN)
	setobjectxyperm(LID_IRENE, 10, 6)  setobjectmovementtype(LID_IRENE, MOVEMENT_TYPE_FACE_UP)
	setobjectxyperm(LID_LETTER,10, 5)  setobjectmovementtype(LID_LETTER, MOVEMENT_TYPE_FACE_LEFT)
	return
}
	
script TrickHouseRestroom_EventScript_VisitorJoey_PlanningPetalburgh {
	msgbox( "But then there are these runes\n"
			"down the side of the door.\p"
			"I've seen them before in the\n"
			"Ruins of Alph back in Johto.\p"
			"They could well be spelling out…$", MSGBOX_SIGN)
}
script TrickHouseRestroom_EventScript_VisitorIrene_PlanningPetalburgh {
	msgbox( "But did you see the strange symbol\n"
			"adorning the bottom?\p"
			"I swear I've seen some of those back\n"
			"home in Dragonspiral Tower…$", MSGBOX_SIGN)
}
script TrickHouseRestroom_EventScript_VisitorJames_PlanningPetalburgh {
	msgbox("This could be the best idea\n"
			"you've ever had, {JOEY}.\p"
			"Think of all the places we can go\n"
			"trick or treating at…$", MSGBOX_SIGN)
}
script TrickHouseRestroom_EventScript_Note_PlanningPetalburgh {
	msgbox ("There's a drawing of the scroll door\n"
			"with a dozen notes about parts of it.", MSGBOX_SIGN)
}

// --------------------------------------------------------
// Petalburgh

script TrickHouseRestroom_OnLoad_Friends_ParaPetalburgh {
	setvar(VAR_FRIEND_GROUP_STATE, 1)
	setobjectxyperm(LID_LETTER,10, 5)  setobjectmovementtype(LID_LETTER, MOVEMENT_TYPE_FACE_LEFT)
	return
}

// --------------------------------------------------------
// Post-Petalburg
// VAR_WALLY_STATE = 1

script TrickHouseRestroom_EventScript_VisitorWally_PostPetalburgh {
	msgbox ("I heard you guys somehow visited\n"
			"Petalburg without me?\p"
			"But how? I was sitting in the entrance\n"
			"the whole time! I didn't see you leave!$", MSGBOX_NPC)
}

// --------------------------------------------------------
// Pre-Pre-Fortree

script TrickHouseRestroom_OnLoad_Friends_PostLedges {
	setvar(VAR_FRIEND_GROUP_STATE, 12)
	setvar(VAR_WALLY_STATE, 3)
	setobjectxyperm(LID_BRENDAN, 4, 7)  setobjectmovementtype(LID_BRENDAN, MOVEMENT_TYPE_LOOK_AROUND)
}
script TrickHouseRestroom_EventScript_VisitorWally_PostLedges {
	checkplayergender
	if (var(VAR_RESULT) == GENDER_M) {
		faceplayer
		message("Woah, {PLAYER}! You okay? You're\n"
				"shaking and your costume's soaked!\p"
				"I mean, I know Mudkips are Water type\n"
				"and all, but this seems--\p"
				"A storm? Where? In the puzzle?\n"
				"Are… are you afraid of lightning?\p$")
		waitmessage
		applymovement(LID_PLAYER, Common_Movement_ExclamationMark)
		playse(SE_PIN)
		message("No, I've never been struck by\n"
				"lightning! Have you?\p$")
		waitmessage
		switch(var(VAR_FACING)) {
			case DIR_NORTH: applymovement(LID_PLAYER, Common_Movement_JumpInPlaceSouth)
			case DIR_SOUTH: applymovement(LID_PLAYER, Common_Movement_JumpInPlaceNorth)
			case DIR_EAST:  applymovement(LID_PLAYER, Common_Movement_JumpInPlaceWest)
			case DIR_WEST:  applymovement(LID_PLAYER, Common_Movement_JumpInPlaceEast)
		}
		playse(SE_LEDGE)
		message("Okay! Okay! I'm sorry!\n"
				"I won't mention it again!$")
		waitmessage
		waitbuttonpress
		release
	} else {
		msgbox ("{PLAYER}, you're dripping wet!\n"
				"Is it raining outside?\p"
				"In the PUZZLE it was raining?$", MSGBOX_NPC)
		
	}
}
script TrickHouseRestroom_EventScript_VisitorBrendan_PostLedges {
	msgbox ("Storm…! Why did it have to storm…?!$", MSGBOX_NPC)
}
movement Common_Movement_JumpInPlaceSouth { jump_in_place_down }
movement Common_Movement_JumpInPlaceNorth { jump_in_place_up }
movement Common_Movement_JumpInPlaceWest { jump_in_place_left }
movement Common_Movement_JumpInPlaceEast { jump_in_place_right }

// --------------------------------------------------------
// Pre-Pre-Fortree

script TrickHouseRestroom_OnLoad_Friends_PrePreFortree {
	setvar(VAR_FRIEND_GROUP_STATE, 11)
	setobjectxyperm(LID_JOEY,  10, 7)  setobjectmovementtype(LID_JOEY, MOVEMENT_TYPE_FACE_DOWN)
	setobjectxyperm(LID_LETTER,10, 8)  setobjectmovementtype(LID_LETTER, MOVEMENT_TYPE_FACE_UP)
}
script TrickHouseRestroom_EventScript_VisitorJoey_PlanningFortree {
	message("So if this rune is the longitudinal\n"
			"offset, and we're here…\p$")
	waitmessage
	faceplayer
	message("Oh, hey, {PLAYER}. Just doing some more\n"
			"research on the Trick Master's door.\p"
			"I wonder just how far away we can\n"
			"point the things…\p"
			"He's given us puzzles in far off places,\n"
			"in other regions entirely…\p"
			"It seems like it could go anywhere,\n"
			"theoretically. But is there a limit?$")
	waitmessage
	waitbuttonpress
	applymovement(LID_JOEY, Common_Movement_FaceDown)
	waitmovement(LID_JOEY)
	release
}

// --------------------------------------------------------
// Pre-Fortree

script TrickHouseRestroom_OnLoad_Friends_PreFortree {
	setvar(VAR_FRIEND_GROUP_STATE, 2)
	setvar(VAR_WALLY_STATE, 101)
	setobjectxyperm(LID_JOEY,  10, 7)  setobjectmovementtype(LID_JOEY, MOVEMENT_TYPE_FACE_DOWN)
	setobjectxyperm(LID_IRENE, 10, 9)  setobjectmovementtype(LID_IRENE, MOVEMENT_TYPE_FACE_UP)
	setobjectxyperm(LID_LETTER,10, 8)  setobjectmovementtype(LID_LETTER, MOVEMENT_TYPE_FACE_DOWN)
	setobjectxyperm(LID_JAMES,  1, 6)  setobjectmovementtype(LID_JAMES, MOVEMENT_TYPE_FACE_DOWN_AND_RIGHT)
	return
}

script TrickHouseRestroom_EventScript_VisitorJoey_FortreeFight {
	goto(TrickHouseRestroom_EventScript_JoeyIreneFight)
}
script TrickHouseRestroom_EventScript_VisitorIrene_FortreeFight {
	goto(TrickHouseRestroom_EventScript_JoeyIreneFight)
}
script TrickHouseRestroom_EventScript_VisitorJames_FortreeFight {
	checkplayergender
	if (var(VAR_RESULT) == GENDER_N) {
		msgbox ("Come to witness the Great Throwdown?\p"
				"{PLAYER}, can you like… go calm your\n"
				"girlfriend down or something?\p"
				"Seriously, I'm about to sneak out\n"
				"and use the door while they're arguing.$", MSGBOX_NPC)
	} else {
		msgbox ("Come to witness the Great Throwdown?\p"
				"I don't understand why they don't\n"
				"just take turns.\p"
				"Seriously, I'm about to sneak out\n"
				"and use the door while they're arguing.$", MSGBOX_NPC)
	}
}
script TrickHouseRestroom_EventScript_VisitorWally_PreFortree {
	msgbox ("Man, they're really going at it over\n"
			"there, aren't they?$", MSGBOX_NPC)
}
script TrickHouseRestroom_EventScript_Note_FortreeFight {
	msgbox ("There's dozens of random scribbles\n"
			"and many words and runes crossed out.", MSGBOX_SIGN)
}

script TrickHouseRestroom_EventScript_JoeyIreneFight {
	lockall
	playbgm(MUS_DP_ENCOUNTER_ELITE_FOUR, FALSE)
	delay(15)
	applymovement(LID_JOEY, TrickHouseRestroom_Movement_JoeyIreneFight_1)
	playse(SE_LEDGE)  delay(16)
	playse(SE_LEDGE)  delay(16)
	waitmovement(LID_JOEY)
	speakername_common(JOEY)
	msgbox ("We don't know yet that the door can\n"
			"go that far!\p"
			"It's already been to Johto!$")
	
	applymovement(LID_IRENE, TrickHouseRestroom_Movement_JoeyIreneFight_2)
	playse(SE_LEDGE)  delay(16)
	playse(SE_LEDGE)  delay(16)
	waitmovement(LID_IRENE)
	speakername_common(IRENE)
	msgbox ("Did you not see the Jungle Maze!?\n"
			"I'm pretty sure that was in New Guinea!$")
	playse(SE_SELECT)
	speakername_common(JOEY)
	msgbox ("That's not in Unova!\n"
			"It's not even outside this timezone!\p"
			"Isn't it like 3am in Unova right now?!$")
	playse(SE_SELECT)
	speakername_common(IRENE)
	msgbox ("It's 6am! And you just want an excuse\n"
			"to go pick up your boyfriend!$")
	playse(SE_SELECT)
	speakername_common(JOEY)
	msgbox ("So what? You can have your partner\n"
			"here, but I can't have mine?!$")
	
	checkplayergender
	if (var(VAR_RESULT) == GENDER_N) {
		playse(SE_SELECT)
		if (var(VAR_LAST_TALKED) == LID_JOEY) {
			faceplayer
		}
		msgbox("Uh, no offense, {PLAYER}.")
		applymovement(LID_JOEY, Common_Movement_FaceDown)
		waitmovement(LID_JOEY)
	}
	fadedefaultbgm
	releaseall
}
movement TrickHouseRestroom_Movement_JoeyIreneFight_1 {
	jump_in_place_down * 2
}
movement TrickHouseRestroom_Movement_JoeyIreneFight_2 {
	jump_in_place_up * 2
}


// --------------------------------------------------------
// During Fortree

script TrickHouseRestroom_OnLoad_Friends_ParaFortree {
	setvar(VAR_FRIEND_GROUP_STATE, 2)
	setvar(VAR_WALLY_STATE, 102)
	setobjectxyperm(LID_JOEY,  10, 7)  setobjectmovementtype(LID_JOEY, MOVEMENT_TYPE_FACE_DOWN)
	setobjectxyperm(LID_IRENE, 10, 9)  setobjectmovementtype(LID_IRENE, MOVEMENT_TYPE_FACE_UP)
	setobjectxyperm(LID_LETTER,10, 8)  setobjectmovementtype(LID_LETTER, MOVEMENT_TYPE_FACE_DOWN)
	return
}
script TrickHouseRestroom_EventScript_VisitorWally_ParaFortree {
	msgbox ("Did you see where {LINK} went?\p"
			"I think he snuck out while I was\n"
			"distracted by their arguing.$", MSGBOX_NPC)
}
// See above for others


