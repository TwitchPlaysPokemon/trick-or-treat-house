script TrickHouseRestroom_OnLoad_Friends_ParaMossdeep {
	setvar(VAR_FRIEND_GROUP_STATE, 3)
	setobjectxyperm(LID_WALLY,  100, 100) // Wally actually goes
	setobjectxyperm(LID_LETTER, 11, 5)  setobjectmovementtype(LID_LETTER, MOVEMENT_TYPE_FACE_UP)
	return
}
script TrickHouseRestroom_EventScript_Note_PreMossdeep {
	msgbox ("There's a ton of random notes and runes\n"
			"on it.\p"
			"In the corner, circled five times, is\n"
			"the word “Mossdeep”.", MSGBOX_SIGN)
}


