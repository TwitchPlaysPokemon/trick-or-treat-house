mapscripts TestFollowerMap_MapScripts {}

raw `
#define FOLLOW_FLAGS FOLLOWER_FLAG_CAN_LEAVE_ROUTE | FOLLOWER_FLAG_CAN_SURF
`

script TestFollowerMap_EventScript_TestCutsceneCamera {
	lock
	// getplayerxy(VAR_INTERACT_X, VAR_INTERACT_Y)
	fadescreen(FADE_TO_BLACK)
	loadarg(0, 5)
	loadarg(1, 5)
	callnative(TeleportCamera)
	fadescreen(FADE_FROM_BLACK)
	// 
	delay(10)
	applymovement(1, TestFollowerMap_Movement_TestCutsceneCamera)
	waitmovement(1)
	delay(10)
	// 
	fadescreen(FADE_TO_BLACK)
	callnative(ResetCameraToPlayer)
	fadescreen(FADE_FROM_BLACK)
	release
}
movement TestFollowerMap_Movement_TestCutsceneCamera {
	walk_down * 3
	walk_left
	walk_up
	walk_right
	walk_up * 2
	walk_in_place_down
}




script TestFollowerMap_EventScript_JoeyFollow {
	lockall
	checkfollower
	if (var(VAR_RESULT) == FALSE) {
		msgbox("Joey is now following you.")
		setfollower(1, FOLLOW_FLAGS)
	}
	else {
		msgbox("Joey is no longer following.")
		destroyfollower
	}
	releaseall
}

script TestFollowerMap_EventScript_AlexFollow {
	lockall
	checkfollower
	if (var(VAR_RESULT) == FALSE) {
		msgbox("Alex is now following you.")
		setfollower(3, FOLLOW_FLAGS | FOLLOWER_FLAG_HAS_RUNNING_FRAMES)
	}
	else {
		msgbox("Alex is no longer following.")
		destroyfollower
	}
	releaseall
}

