raw `
#define LID_HM_ROCKSMASH  7
#define LID_ROCK_1  8
#define LID_ROCK_2  9
#define LID_ROCK_3  10
#define LID_ROCK_4  11
#define LID_PEDESTAL  12
#define LID_BUTTON_S  5
#define LID_BUTTON_N  6

Meta_LedgeRoom_MapScripts::
	puzzle_info Puzzle_MetaPuzzle_Name, CommonAuthor_Tustin2121
	map_script MAP_SCRIPT_ON_LOAD, Meta_LedgeRoom_OnLoad
	map_script MAP_SCRIPT_ON_TRANSITION, Meta_LedgeRoom_OnTransition
	map_script MAP_SCRIPT_ON_PLAY_MAP_MUSIC, Meta_LedgeRoom_OnPlayMapMusic
	.byte 0
`

script(local) Meta_LedgeRoom_OnPlayMapMusic {
	getplayerxy(VAR_INTERACT_X, VAR_INTERACT_Y)
	addvar(VAR_INTERACT_X, VAR_INTERACT_Y)
	// Basically make a diagonal line across the map, top-right to bottom-left
	if (var(VAR_INTERACT_X) > 40) {
		setvar(VAR_RESULT, MUS_RG_ROUTE11)
	} else {
		setvar(VAR_RESULT, MUS_HG_ROUTE11)
	}
}
script(local) Meta_LedgeRoom_OnTransition {
	// set_meta_visited_flag(MAP_META_LEDGE_ROOM)
}

script(local) Meta_LedgeRoom_OnLoad {
	if (var(VAR_LOC_ROCK_SMASH) != MAP_META_LEDGE_ROOM) {
		setobjectxyperm(LID_ROCK_1, 7, 26)
		setobjectxyperm(LID_ROCK_2, 6, 30)
		setobjectxyperm(LID_ROCK_3, 10, 33)
		setobjectxyperm(LID_ROCK_4, 17, 27)
		setobjectxyperm(LID_HM_ROCKSMASH, 100, 100)
	}
	if (var(VAR_LOC_PEDESTAL2) != MAP_META_LEDGE_ROOM 
	 && var(VAR_LOC_PEDESTAL3) != MAP_META_LEDGE_ROOM 
	 && var(VAR_LOC_PEDESTAL4) != MAP_META_LEDGE_ROOM)
	{
		setobjectxyperm(LID_PEDESTAL, 100, 100)
	}
	
	check_meta_visited_flag(MAP_META_LEDGE_ROOM)
	goto_if(FALSE, Common_EventScript_NopReturn)
	setmetatile(29, 13, 0x396, FALSE)
	setmetatile(29, 17, 0x396, FALSE)
	turnobject(LID_BUTTON_N, DIR_NORTH)
	turnobject(LID_BUTTON_S, DIR_NORTH)
	setvar(VAR_TEMP_1, 1)
	setvar(VAR_TEMP_2, 1)
}

script Meta_LedgeRoom_ButtonNorth {
	waitse
	playse(SE_PIN)
	setmetatile(29, 13, 0x396, FALSE)
	turnobject(LID_BUTTON_N, DIR_NORTH)
	special(DrawWholeMapView)
	setvar(VAR_TEMP_2, 1)
	if (var(VAR_TEMP_1) == 1) {
		waitse
		delay(10)
		set_meta_visited_flag(MAP_META_LEDGE_ROOM)
		playfanfare(MUS_LEVEL_UP)
	}
}
script Meta_LedgeRoom_ButtonSouth {
	waitse
	playse(SE_PIN)
	setmetatile(29, 17, 0x396, FALSE)
	turnobject(LID_BUTTON_S, DIR_NORTH)
	special(DrawWholeMapView)
	setvar(VAR_TEMP_1, 1)
	if (var(VAR_TEMP_2) == 1) {
		waitse
		delay(10)
		set_meta_visited_flag(MAP_META_LEDGE_ROOM)
		playfanfare(MUS_LEVEL_UP)
	}
}


