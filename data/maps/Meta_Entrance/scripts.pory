raw `
#define LID_MASTER 16

Meta_Entrance_MapScripts::
	puzzle_info Puzzle_MetaPuzzle_Name, CommonAuthor_Tustin2121
	map_script MAP_SCRIPT_ON_TRANSITION, Meta_Entrance_OnTransition
	map_script MAP_SCRIPT_ON_LOAD, Meta_Entrance_OnLoad
	map_script MAP_SCRIPT_ON_FRAME_TABLE, Meta_Entrance_FrameTable
	.byte 0
	
Meta_Entrance_FrameTable:
	map_script_2 VAR_TEMP_A, 0, Meta_Entrance_ShowMapNamePopup
	.2byte 0
`

script(local) Meta_Entrance_ShowMapNamePopup {
	if (!flag(FLAG_IS_PUZZLE_INTRODUCED)) {
		special(ShowMapNamePopup)
		setflag(FLAG_IS_PUZZLE_INTRODUCED)
	}
	setvar(VAR_TEMP_A, 1)
	release
}
script(local) Meta_Entrance_OnTransition {
	set_meta_visited_flag(MAP_META_ENTRANCE)
}
script(local) Meta_Entrance_OnLoad {
	if (var(VAR_GRID_SIZE) == GRID_SIZE_1x2) {
		setobjectxyperm(LID_MASTER, 100, 100) // move off map
	}
	if (var(VAR_TIMES_SHIFTED) == 0) { // not yet shifted the puzzle
		setobjectxyperm(LID_MASTER, 100, 100) // move off map
	}
}

script Meta_Entrance_Dev {
	speakername("Tustin2121")
	msgbox ("Oh hey, you found this back room, huh?\p"
			"This puzzle can be a mess. It has\n"
			"broken already in like 100 ways.\p"
			"So, just in case, these balls here are\n"
			"all the HMs you'll need to get through.\p"
			"And there's emergency-use-only scroll\n"
			"and pedestals to the right.\p"
			"This is an honor system thing.\n"
			"Use one only if you get stuck.\p"
			"And sorry if you did get stuck.$", MSGBOX_NPC)
}

raw `
#undef LID_MASTER
`