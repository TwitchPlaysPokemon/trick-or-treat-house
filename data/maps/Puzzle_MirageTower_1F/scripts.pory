raw `
Puzzle_MirageTower_1F_MapScripts::
	puzzle_info Puzzle_MirageTower_1F_Name, Puzzle_MirageTower_1F_Author
	puzzle_adjective Puzzle_MirageTower_1F_Adjective
	puzzle_quip Puzzle_MirageTower_1F_Quip
	//puzzle_setup_script Puzzle_MirageTower_1F_SetupScript
