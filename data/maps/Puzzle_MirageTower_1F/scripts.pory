	.byte 0

Puzzle_MirageTower_1F_Name:
	.string "Sandy Ascent$"
Puzzle_MirageTower_1F_Author:
	.string "YugnatZero$"
Puzzle_MirageTower_1F_Adjective:
	.string "mirageful$"
Puzzle_MirageTower_1F_Quip:
	.string "Oh! Oh my!\n"
	.string "I can see Mirage Tower today!\p"
	.string "… … …\p"
	.string "It's, uh, right where you came from.\n"
	.string "I guess you knew that already, huh.$"
.align 2
Puzzle_MirageTower_1F_Items:
	.2byte ITEM_MACH_BIKE
	.2byte 0
Puzzle_MirageTower_1F_Variables:
	.2byte VAR_QUIP_PERSON, OBJ_EVENT_GFX_EXPERT_M
