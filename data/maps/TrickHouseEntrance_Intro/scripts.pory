
raw `
#define LID_MASTER 1
#define LID_LINK 2
#define LID_JOEY 3
#define LID_RIVAL 4
#define LID_WALLY 5
#define LID_FAIRY 6
#define LID_RIVALB 7
`
mapscripts TrickHouseEntrance_Intro_MapScripts {
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_INTRO_COUNTER, 2: TrickHouseEntrance_WalkInCutscene
		VAR_INTRO_COUNTER, 4: TrickHouseEntrance_IntroCutscene
	]
	MAP_SCRIPT_ON_LOAD {
		switch (var(VAR_INTRO_COUNTER)) {
			case 2:
			case 3:
				setmetatile (5, 1, 0x20B, TRUE) // Close scroll door
				setobjectmovementtype (1, MOVEMENT_TYPE_INVISIBLE)
		}
	}
	MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
		VAR_INTRO_COUNTER, 2: TrickHouseEntrance_OnWarp_Setup
		VAR_INTRO_COUNTER, 3: TrickHouseEntrance_OnWarp_Setup
		VAR_INTRO_COUNTER, 4 {
			addobject (LID_MASTER)
			setobjectxy(LID_MASTER, 5, 2)   turnobject(LID_MASTER, DIR_SOUTH)
			setobjectxy(LID_LINK,   3, 3)   turnobject(LID_LINK,   DIR_EAST)
			setobjectxy(LID_JOEY,   3, 4)   turnobject(LID_JOEY,   DIR_NORTH)
			setobjectxy(LID_WALLY,  7, 4)   turnobject(LID_WALLY,  DIR_NORTH)
			setobjectxy(LID_FAIRY,  7, 3)   turnobject(LID_FAIRY,  DIR_WEST)
			setobjectxy(LID_RIVAL,  4, 4)   turnobject(LID_RIVAL,  DIR_NORTH)
			setobjectxy(LID_RIVALB, 6, 4)   turnobject(LID_RIVALB, DIR_NORTH)
			turnobject(LID_PLAYER, DIR_NORTH)
		}
	]
	MAP_SCRIPT_ON_TRANSITION {
		if (var(VAR_INTRO_COUNTER) == 4) {
			setmaplayout(LAYOUT_TRICK_HOUSE_ENTRANCE)
		}
		checkplayergender
		switch(var(VAR_RESULT)) {
			case GENDER_M:
				setvar (VAR_OBJ_GFX_ID_A, TTH_FRIEND_ALEX)
				setvar (VAR_OBJ_GFX_ID_B, TTH_FRIEND_MAY)
			case GENDER_F:
				setvar (VAR_OBJ_GFX_ID_A, TTH_FRIEND_BRENDAN)
				setvar (VAR_OBJ_GFX_ID_B, TTH_FRIEND_ALEX)
			case GENDER_N:
				setvar (VAR_OBJ_GFX_ID_A, TTH_FRIEND_BRENDAN)
				setvar (VAR_OBJ_GFX_ID_B, TTH_FRIEND_MAY)
		}
	}
}

script(local) TrickHouseEntrance_OnWarp_Setup {
	loadarg(0, 6)
	callnative (GetTrainerIDMod)
	setobjectmovementtype (1, MOVEMENT_TYPE_INVISIBLE)
	addobject (1)
	switch (var(VAR_RESULT)) {
		case 0:  setobjectxy (LID_MASTER,11, 1) // Cabinet on right
		case 1:  setobjectxy (LID_MASTER,11, 5) // Plant on right
		case 2:  setobjectxy (LID_MASTER, 0, 5) // Plant on left
		case 3:  setobjectxy (LID_MASTER, 6, 3) // Under table TR
		case 4:  setobjectxy (LID_MASTER, 4, 4) // Under cushion BL
		case 5:  setobjectxy (LID_MASTER, 3, 1) // Window on left
		default: setobjectxy (LID_MASTER, 8, 1) // Window on right
	}
	copyobjectxytoperm(LID_MASTER)
	turnobject(LID_WALLY, DIR_NORTH)
}


script TrickHouseEntrance_WalkInCutscene {
	lock
	applymovement (LID_PLAYER, Common_Movement_WalkUp1)
	waitmovement (0)
	msgbox ("You're being watched…$")
	applymovement (LID_PLAYER, Common_Movement_WalkInPlaceLeft)
	applymovement (LID_WALLY, Common_Movement_WalkInPlaceRight)
	waitmovement (0)
	speakername_common(WALLY)
	msgbox ("Uhhhh, do we have to be here?\n"
			"I don't like this place!\p"
			"I'm sticking close to you.$")
	// Setup follower
	setfollower(LID_WALLY, FOLLOWER_FLAG_FRIENDS, TrickHouseEntrance_FollowerScript_Wally)
	setvar(VAR_FOLLOWER_STATE, 0)
	setvar(VAR_FOLLOWER_IDENTITY, FOLLOWER_ID_WALLY)
	
	setvar (VAR_INTRO_COUNTER, 3)
	release
}

script TrickHouseEntrance_IntroCutscene {
	lockall
	setstepcallback (STEP_CB_CYCLE_TEXT_PAL)
	speakername_common(TRICK_MASTER)
	msgbox (PuzzleCommon_Text_GameIntro, MSGBOX_SIGN)
	setstepcallback (STEP_CB_DUMMY)
	setvar (VAR_0x8000, 1)
	call (PuzzleCommon_EventScript_WarpTrickMasterOut)
	//
	opendoor (5, 1)
	delay(10)
	applymovement (LID_FAIRY, Common_Movement_WalkInPlaceDown)
	applymovement (LID_RIVAL, Common_Movement_WalkInPlaceLeft)
	delay(4)
	applymovement (LID_LINK, Common_Movement_WalkInPlaceDown)
	applymovement (LID_JOEY, Common_Movement_WalkInPlaceUp)
	delay(7)
	applymovement (LID_RIVALB, Common_Movement_WalkInPlaceRight)
	applymovement (LID_PLAYER, Common_Movement_WalkInPlaceLeft)
	delay(5)
	applymovement (LID_WALLY, Common_Movement_WalkInPlaceLeft)
	delay(17)
	applymovement (LID_RIVAL, Common_Movement_WalkInPlaceRight)
	delay(6)
	applymovement (LID_LINK, Common_Movement_WalkInPlaceRight)
	applymovement (LID_JOEY, Common_Movement_WalkInPlaceRight)
	delay(8)
	applymovement (LID_RIVALB, Common_Movement_WalkInPlaceLeft)
	delay(5)
	applymovement (LID_WALLY, Common_Movement_WalkInPlaceUp)
	applymovement (LID_PLAYER, Common_Movement_WalkInPlaceRight)
	delay(4)
	applymovement (LID_FAIRY, Common_Movement_WalkInPlaceLeft)
	delay(17)
	// Irene goes in
	speakername_common(IRENE)
	message("Puzzles? I'm all for that!\n"
			"Let's go!$")
	applymovement (LID_FAIRY, TrickHouseEntrance_Movement1_Fairy)
	delay (6)
	applymovement (LID_RIVALB, Common_Movement_WalkInPlaceUp)
	applymovement (LID_PLAYER, Common_Movement_WalkInPlaceUp)
	delay (8)
	applymovement (LID_RIVAL, Common_Movement_WalkInPlaceUp)
	applymovement (LID_JOEY, Common_Movement_WalkInPlaceRight)
	applymovement (LID_WALLY, Common_Movement_WalkInPlaceUp)
	delay (10)
	applymovement (LID_LINK, Common_Movement_WalkInPlaceUp)
	waitmessage
	waitbuttonpress
	playse (SE_SELECT)
	//
	applymovement (LID_FAIRY, TrickHouseEntrance_Movement2_Fairy)
	applymovement (LID_WALLY, Common_Movement_WalkUp1)
	speakername_common(WALLY)
	msgbox ("{FAIRY}!$")
	waitmovement (LID_FAIRY)
	closemessage
	//
	delay (10)
	applymovement (LID_LINK, TrickHouseEntrance_Movement1_Link)
	delay (8)
	applymovement (LID_WALLY, Common_Movement_WalkInPlaceDown)
	speakername_common(LINK)
	message("That TRICK guy said there was\n"
			"candy to get, right?!\p"
			"Yeah! I'm with {FAIRY}!\n"
			"Coming, {YOUNGSTER}?$")
	waitmessage
	waitmovement(LID_LINK)
	waitbuttonpress
	playse (SE_SELECT)
	//
	applymovement (LID_LINK, TrickHouseEntrance_Movement2_Link)
	applymovement (LID_JOEY, TrickHouseEntrance_Movement2_Joey)
	speakername_common(JOEY)
	message("Heck yeah, I'm in!{PAUSE 60}$")
	waitmessage
	waitbuttonpress
	closemessage
	waitmovement(LID_LINK)
	//waitmovement(LID_JOEY)
	//
	checkplayergender
	switch(var(VAR_RESULT)) {
		case GENDER_M:
			// TODO: Alex steps forward and says it looks neat
			// TODO: May asks if Brendan is coming and goes in after Alex
			speakername_common(ALEX)
			message("If {IRENE}'s in, I'm in.\n"
					"She loves weird things like this.$")
			applymovement(LID_RIVAL, TrickHouseEntrance_Movement3_Rival)
			waitmessage
			waitmovement(LID_RIVAL)
			waitbuttonpress
			playse (SE_SELECT)
			
			speakername_common(MAY)
			message("Yeah, this sounds fun!\n"
					"Coming {PLAYER}?$")
			applymovement(LID_RIVALB, TrickHouseEntrance_Movement3_Rival)
			waitmessage
			waitmovement(LID_RIVALB)
			waitbuttonpress
			closemessage
			
			applymovement(LID_RIVALB, Common_Movement_FaceLeft)
			applymovement(LID_RIVAL, TrickHouseEntrance_Movement4_RivalA)
			waitmovement(LID_RIVAL)
			applymovement(LID_RIVALB, TrickHouseEntrance_Movement4_RivalB)
			waitmovement(LID_RIVALB)
			
		case GENDER_F:
			// TODO: Brendan steps forward, says it looks fun, possibly says something insensitive, runs in
			// TODO: Alex sighs after him, saying that's not how that works, and asks if the player is coming
			speakername_common(BRENDAN)
			message("This sound like a blast! Come on, guys!\n"
					"Uh… A-And 'theys'…? {ALEX}…{PAUSE 30} Uh…$")
			applymovement(LID_RIVAL, TrickHouseEntrance_Movement3_Rival)
			waitmessage
			waitmovement(LID_RIVAL)
			waitbuttonpress
			playse (SE_SELECT)
			
			speakername_common(ALEX)
			message("{BRENDAN}, 'Guys' is gender neutral…\n"
					"Sigh… He tries…\p"
					"Com'on, Cuz'.\n"
					"Don't dally too far behind!$")
			applymovement(LID_RIVALB, TrickHouseEntrance_Movement3_Rival)
			applymovement(LID_RIVAL, TrickHouseEntrance_Movement4_RivalA)
			waitmessage
			waitmovement(LID_RIVAL)
			waitmovement(LID_RIVALB)
			waitbuttonpress
			closemessage
			
			applymovement(LID_RIVALB, TrickHouseEntrance_Movement4_RivalB)
			waitmovement(LID_RIVALB)
			
		case GENDER_N:
			// TODO: Brendan steps forward, says it looks fun, possibly says something insensitive, runs in
			// TODO: May chides him as she goes after him.
			// TODO: Brendan steps forward, says it looks fun, possibly says something insensitive, runs in
			// TODO: Alex sighs after him, saying that's not how that works, and asks if the player is coming
			speakername_common(BRENDAN)
			message("This sound like a blast! Come on, guys!\n"
					"Uh… A-And 'theys'…? {ALEX}…{PAUSE 30} Uh…$")
			applymovement(LID_RIVAL, TrickHouseEntrance_Movement3_Rival)
			waitmessage
			waitmovement(LID_RIVAL)
			waitbuttonpress
			playse (SE_SELECT)
			
			speakername_common(MAY)
			message("{BRENDAN}, it's not that… ugh…\p"
					"I don't get it. Everyone else is fine\n"
					"with it, but he's still awkward.\p"
					"Anyway, come on, this looks fun!$")
			applymovement(LID_RIVALB, TrickHouseEntrance_Movement3_Rival)
			applymovement(LID_RIVAL, TrickHouseEntrance_Movement4_RivalA)
			waitmessage
			waitmovement(LID_RIVAL)
			waitmovement(LID_RIVALB)
			waitbuttonpress
			closemessage
			
			applymovement(LID_RIVALB, TrickHouseEntrance_Movement4_RivalB)
			waitmovement(LID_RIVALB)
	}
	closedoor (5, 1)
	waitdooranim
	
	applymovement (LID_WALLY, Common_Movement_WalkDown1)
	waitmovement (LID_WALLY)
	delay (10)
	applymovement (LID_PLAYER, Common_Movement_WalkInPlaceRight)
	delay (20)
	speakername_common(WALLY)
	msgbox ("I'm… just hang out here, I guess…\p"
			"You go if you want. I don't really want to\n"
			"get in the way…$")
	// Cleanup
	removeobject (LID_RIVAL)
	removeobject (LID_JOEY)
	removeobject (LID_FAIRY)
	removeobject (LID_LINK)
	removeobject (LID_RIVALB)
	setflag (FLAG_HIDE_TRICK_HOUSE_INTRO_CHARACTERS)
	setvar (VAR_INTRO_COUNTER, 5)
	releaseall
}

movement TrickHouseEntrance_Movement1_Fairy {
	walk_up
	walk_left * 2
	walk_in_place_fast_down
}
movement TrickHouseEntrance_Movement2_Fairy {
	walk_up
	set_invisible
}
movement TrickHouseEntrance_Movement1_Link {
	walk_up
	walk_right
	walk_in_place_fastest_down
}
movement TrickHouseEntrance_Movement2_Link {
	delay_4
	walk_in_place_fast_left
	delay_16
	walk_right
	walk_up
	set_invisible
}
movement TrickHouseEntrance_Movement2_Joey {
	walk_up * 2
	walk_right * 2
	walk_up
	set_invisible
}

movement TrickHouseEntrance_Movement3_Rival {
	walk_up * 2
	face_down
}
movement TrickHouseEntrance_Movement4_RivalA {
	walk_right
	walk_up
	set_invisible
}
movement TrickHouseEntrance_Movement4_RivalB {
	walk_left
	walk_up
	set_invisible
}

///////////////////////////////////////////////////////

script TrickHouseEntrance_EventScript_TrickMaster {
	switch (var(VAR_INTRO_COUNTER)) {
		case 3: goto (TrickHouseEntrance_EventScript_FindTrickMaster)
	}
}
script TrickHouseEntrance_EventScript_FindTrickMaster {
	lockall
	loadarg(0, 6)
	callnative (GetTrainerIDMod)
	speakername_common(TRICK_MASTER)
	switch (var(VAR_RESULT)) {
		case 0: msgbox ("Hah? Girr…\p"
				"How did you know I concealed myself\n"
				"in this cupboard? You're sharp!$")
		case 1: msgbox ("Hah? Girr…\p"
				"How did you know I concealed myself\n"
				"behind this tree? You're sharp!$")
		case 2: msgbox ("Hah? Girr…\p"
				"How did you know I concealed myself\n"
				"in this planter? You're sharp!$")
		case 3: msgbox ("Hah? Girr…\p"
				"How did you know I concealed myself\n"
				"beneath this desk? You're sharp!$")
		case 4: msgbox ("Hah? Girr…\p"
				"How did you know I concealed myself\n"
				"beneath this cushion? You're sharp!$")
		default: msgbox ("Hah? Girr…\p"
				"How did you know I concealed myself\n"
				"behind this window? You're sharp!$")
	}
	setvar (VAR_INTRO_COUNTER, 4)
	fadescreen(FADE_TO_BLACK)
	warpcustom (MAP_TRICK_HOUSE_ENTRANCE_INTRO, 5, 4)
	destroyfollower
	waitstate
	releaseall
}

raw `
#undef LID_RIVAL
#undef LID_JOEY
#undef LID_FAIRY
#undef LID_WALLY
#undef LID_LINK
`


script TrickHouseEntrance_EventScript_Link {
	speakername_common(JAMES)
	msgbox ("Man, I don't see any candy\n"
			"around here!\p"
			"We could be in Slateport right now\n"
			"hauling in the big dough!$", MSGBOX_NPC)
}
script TrickHouseEntrance_EventScript_Joey {
	lock
	speakername_common(JOEY)
	message("{JAMES}, chill!\p"
			"We've got plenty of time for more\n"
			"trick-or-treating!\p$")
	waitmessage
	faceplayer
	message("And people call ME the annoying one.\p"
			"C'mon, I haven't talked about my\n"
			"Rattata in a whole ten minutes!$")
	waitmessage
	waitbuttonpress
	closemessage
	applymovement (THIS_EVENT, Common_Movement_FaceRight)
	waitmovement (0)
	release
}
script TrickHouseEntrance_EventScript_Fairy {
	checkplayergender
	speakername_common(IRENE)
	if (var(VAR_RESULT) == GENDER_N) {
	msgbox ("Hey, Boo. What do you think?\n"
			"This place looks swept clean.\p"
			"Maybe there's someone here…?$", MSGBOX_NPC)
	} else {
	msgbox ("This place has been swept clean\n"
			"recently, so it's not haunted.\p"
			"Maybe someone's around…$", MSGBOX_NPC)
	}
}
script TrickHouseEntrance_EventScript_RivalA {
	checkplayergender
	 // Rival A is Alex
	goto_if_eq(VAR_RESULT, MALE, TrickHouseEntrance_EventScript_RivalAlex)
	speakername_common(BRENDAN)
	msgbox ("Maybe we can find who's watching\n"
			"us if we look around…\p"
			"{WALLY}, dude, it's fine. We're all\n"
			"here. No one's gonna kidnap you.$", MSGBOX_NPC)
}
script TrickHouseEntrance_EventScript_RivalB {
	checkplayergender
	// Rival B is Alex
	goto_if_eq(VAR_RESULT, FEMALE, TrickHouseEntrance_EventScript_RivalAlex)
	speakername_common(MAY)
	msgbox ("Could it be possible that the Trick\n"
			"Master has returned from his trip?\p"
			"I wonder what he's got up his sleeves\n"
			"for us then.$", MSGBOX_NPC)
}
script(local) TrickHouseEntrance_EventScript_RivalAlex {
	speakername_common(ALEX)
	msgbox( "Please tell me I'm not the only\n"
			"on creeped out right now…\p"
			"Judging by the way {WALLY} is hanging\n"
			"on, I'm guessing I'm not.\p"
			"Makes me feel a little better.$", MSGBOX_NPC)
}

script TrickHouseEntrance_Intro_EventScript_Wally {
	speakername_common(WALLY)
	msgbox ("I-I'll just be here…\n"
			"A-Alone…\p"
			"My auntie wouldn't like me going into\n"
			"strange men's puzzle dungeons…$", MSGBOX_NPC)
}

// ----------------------------------------------------

script TrickHouseEntrance_FollowerScript_Wally {
	lock
	facefollower
	speakername_common(WALLY)
	callnative(GetCurrentMapId)
	goto_if_eq(VAR_RESULT, MAP_TRICK_HOUSE_ENTRANCE, TrickHouseEntrance_FollowerScript_Wally_Entryway)
	goto_if_eq(VAR_RESULT, MAP_TRICK_HOUSE_ENTRANCE_INTRO, TrickHouseEntrance_FollowerScript_Wally_Entryway)
	goto_if_eq(VAR_RESULT, MAP_TRICK_HOUSE_EXT, TrickHouseEntrance_FollowerScript_Wally_Ext)
	goto_if_eq(VAR_RESULT, MAP_TRICK_HOUSE_EXT_GATEHOUSE, TrickHouseEntrance_FollowerScript_Wally_Gatehouse)
	goto_if_eq(VAR_RESULT, MAP_TRICK_HOUSE_TREE_HOUSE, TrickHouseEntrance_FollowerScript_Wally_Treehouse)
	goto_if_eq(VAR_RESULT, MAP_FAKE_SECRET_BASE_CAVE, TrickHouseEntrance_FollowerScript_Wally_SecretBase)
	
	msgbox ("D-Don't mind me. I'm just…\n"
			"S-Sticking close…$")
	release
}
script TrickHouseEntrance_FollowerScript_Wally_Entryway {
	msgbox ("I-I-I feel like someone's watching us…$")
	release
}
script TrickHouseEntrance_FollowerScript_Wally_Ext {
	getplayerxy(VAR_INTERACT_X, VAR_INTERACT_Y)
	if (flag(FLAG_FOLLOWER_FLAG_1) && !flag(FLAG_FOLLOWER_FLAG_2)) {
		msgbox ("LET'S NEVER GOT BACK INTO THAT\n"
				"GATEHOUSE EVER AGAIN, OKAY?!?!?!$")
		setflag(FLAG_FOLLOWER_FLAG_2)
	}
	elif (var(VAR_INTERACT_X) < 23) {
		msgbox ("What's that cave over there?\n"
				"Do you see it?$")
	}
	elif (var(VAR_INTERACT_X) > 49) {
		msgbox ("Uh, should we be out this far into\n"
				"the grass?\p"
				"Do YOU have {POKEMON} on you?\n"
				"I don't wanna have to save you…$")
	}
	elif (var(VAR_INTERACT_Y) > 55) {
		msgbox ("Are they playing card games?$")
	}
	elif (var(VAR_INTERACT_Y) > 38) {
		msgbox ("Sweet! There's a tree house here now!$")
	}
	else {
		msgbox ("It's so much nicer out here…\n"
				"Can we just stay out here?$")
	}
	release
}
script TrickHouseEntrance_FollowerScript_Wally_Gatehouse {
	setflag(FLAG_FOLLOWER_FLAG_1)
	if (var(VAR_TEMP_0) == 1) {
		speakername(NULL)
		msgbox( "{WALLY}'s face is as pale as a sheet\n"
				"of paper! He's vibrating violently!$")
	}
	elif (var(VAR_TEMP_0) == 2) {
		speakername(NULL)
		msgbox( "{WALLY} says something at you in such\n"
				"a high pitched voice, you're sure\l"
				"that only Zubat could understand him.$")
	}
	else {
		msgbox ("No! Please no! Let's get out of here!\n"
				"Now!! Please!!!$")
	}
	release
}
script TrickHouseEntrance_FollowerScript_Wally_Treehouse {
	msgbox ("This is cozy.\p"
			"Maybe I should just hang out here while\n"
			"you guys visit the haunted trick house.$")
	release
}
script TrickHouseEntrance_FollowerScript_Wally_SecretBase {
	msgbox ("So, does that mean the Trick Master IS\n"
			"back in Hoenn?$")
	release
}

